# Copie para .env e ajuste. Valores abaixo servem somente ao ambiente local.
APP_ENV=development
APP_BASE_URL=http://localhost:9292
APP_SECRET_KEY_BASE=locentra-local-troque-este-valor-por-64-caracteres-aleatorios-0000
APP_ENCRYPTION_KEY=locentra-local-chave-de-cifragem-32b

# Superusuário do container PostgreSQL (somente inicialização local).
POSTGRES_PASSWORD=locentra-local-superuser
LOCENTRA_OWNER_PASSWORD=locentra-local-owner
LOCENTRA_APP_PASSWORD=locentra-local-app
LOCENTRA_WORKER_PASSWORD=locentra-local-worker
LOCENTRA_BACKUP_PASSWORD=locentra-local-backup

# Credenciais separadas: migrations (proprietário), aplicação e worker.
MIGRATION_DATABASE_URL=postgres://locentra_owner:locentra-local-owner@postgres:5432/locentra
DATABASE_URL=postgres://locentra_app:locentra-local-app@postgres:5432/locentra
WORKER_DATABASE_URL=postgres://locentra_worker:locentra-local-worker@postgres:5432/locentra
# Somente para bin/backup (papel somente leitura com BYPASSRLS).
BACKUP_DATABASE_URL=postgres://locentra_backup:locentra-local-backup@postgres:5432/locentra

# Banco de testes (mesmos papéis, banco separado).
TEST_MIGRATION_DATABASE_URL=postgres://locentra_owner:locentra-local-owner@postgres:5432/locentra_test
TEST_DATABASE_URL=postgres://locentra_app:locentra-local-app@postgres:5432/locentra_test
TEST_WORKER_DATABASE_URL=postgres://locentra_worker:locentra-local-worker@postgres:5432/locentra_test

# Execução
WEB_CONCURRENCY=0
PUMA_THREADS=5
# Conexões do pool do processo web (>= PUMA_THREADS) e espera máxima por conexão, em segundos.
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=5
WORKER_CONCURRENCY=4
# Threads do worker dedicadas à fila de entregas de webhook.
WEBHOOK_CONCURRENCY=1
# Arquivo de vida do worker, conferido por `bin/worker --check` (healthcheck do contêiner).
WORKER_HEALTH_FILE=/app/tmp/worker.alive
LOG_LEVEL=info
# Proxies reversos cujo X-Forwarded-For é aceito (IPs ou CIDRs, separados por vírgula). Vazio: o IP do
# cliente é o par da conexão.
TRUSTED_PROXIES=
# Requisições por minuto por credencial na API.
API_RATE_LIMIT=1200

# E-mail (Mailpit local)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=Locentra <nao-responda@locentra.local>

# Pagamentos: provedores que as organizações podem configurar (simulator, asaas). Padrão: os dois fora de
# produção e somente asaas em produção (o simulador confirma pagamentos sem dinheiro real). A conta e a
# chave de API são cadastradas por organização em Financeiro → Provedor, cifradas no banco.
PAYMENT_PROVIDERS=simulator,asaas
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Arquivos
STORAGE_ROOT=/app/storage
MAX_UPLOAD_BYTES=10485760

# Token exigido em /metrics (Authorization: Bearer <token>). Em produção, sem token o endpoint fica
# desativado (404).
METRICS_TOKEN=
