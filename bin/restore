#!/usr/bin/env bash
# Restauração em banco vazio, executada por administrador do PostgreSQL (superusuário), preservando os
# proprietários originais (locentra_owner) e as políticas de RLS. Nunca restaure sobre o banco em uso:
# restaure em um banco novo, valide e só então troque a configuração da aplicação.
#
# Uso: RESTORE_ADMIN_URL=postgres://postgres:...@host/postgres bin/restore <diretório do backup> <banco novo> [STORAGE_DESTINO]
set -euo pipefail
src="${1:?uso: bin/restore <diretório do backup> <banco novo> [destino dos anexos]}"
target="${2:?informe o nome do banco novo}"
storage_dest="${3:-}"
: "${RESTORE_ADMIN_URL:?defina RESTORE_ADMIN_URL (superusuário do PostgreSQL)}"

( cd "$src" && sha256sum --check --quiet MANIFESTO.sha256 )
psql "$RESTORE_ADMIN_URL" -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"$target\" OWNER locentra_owner"
target_url="${RESTORE_ADMIN_URL%/*}/$target"
pg_restore --exit-on-error --dbname="$target_url" "$src/banco.dump"
psql "$target_url" -v ON_ERROR_STOP=1 \
  -c "GRANT CONNECT, TEMPORARY ON DATABASE \"$target\" TO locentra_owner, locentra_app, locentra_worker" \
  -c "GRANT CONNECT ON DATABASE \"$target\" TO locentra_backup"

if [ -n "$storage_dest" ] && [ -f "$src/anexos.tar.gz" ]; then
  mkdir -p "$storage_dest"
  tar -C "$storage_dest" -xzf "$src/anexos.tar.gz"
fi
echo "Restaurado em $target. Valide com: MIGRATION_DATABASE_URL=<owner@$target> bin/locentra-admin db:status"
