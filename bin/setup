#!/usr/bin/env bash
# Prepara o ambiente local: imagens, PostgreSQL, Mailpit, migrations, seed e processo web.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  cp .env.example .env
  echo "Criado .env a partir de .env.example (valores somente para uso local)."
fi

docker compose build
docker compose up -d --wait postgres mailpit
docker compose --profile ops run --rm migrate
docker compose run --rm --no-deps web ruby bin/locentra-admin db:seed
docker compose up -d --wait web worker

cat <<'MSG'

Locentra disponível em http://localhost:9292
Mailpit (e-mails locais) em http://localhost:8025

Usuários demonstrativos (senha: locentra-local-demo):
  ana@alfa.demo   (proprietária, Alfa Audiovisual)
  paulo@beta.demo (proprietário, Beta Eventos)
MSG
