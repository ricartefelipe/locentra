<header class="page-header">
  <div>
    <h1>Disponibilidade e solicitação de reserva</h1>
    <p class="page-meta"><span>Consulte os itens disponíveis no período desejado e envie uma solicitação de reserva à locadora.</span></p>
  </div>
  <div class="actions"><a class="button ghost" href="/portal/reservas">Minhas reservas</a></div>
</header>
<ol class="steps" aria-label="Etapas da solicitação">
  <li class="<%= @result ? "done" : "current" %>">Período e local de retirada</li>
  <li<%= raw(@result ? ' class="current"' : "") %>>Itens e quantidades</li>
  <li>Confirmação pela locadora</li>
</ol>
<% unless @result && !@result.empty? %><div class="notice" role="note"><%= Locentra::Domain::Portal::REQUEST_NOTICE %></div><% end %>
<%= partial("shared/errors") %>
<section class="panel" aria-labelledby="consulta-titulo">
  <h2 id="consulta-titulo">Período e local de retirada</h2>
  <% if @branches.empty? %>
    <p class="empty">Nenhuma filial disponível para retirada no momento.</p>
  <% else %>
    <form method="get" action="/portal/disponibilidade" class="form-grid">
      <div><label for="filial">Filial</label>
        <select id="filial" name="filial"<%= invalid(@errors, "filial") %>>
          <% @branches.each do |b| %><option value="<%= b.id %>"<%= selected(@values["filial"], b.id) %>><%= b.name %></option><% end %>
        </select>
        <%= field_errors(@errors, "filial") %></div>
      <div><label for="inicio">Retirada<span class="sr-only"> (horário local <%= time_zone.identifier %>)</span></label>
        <input id="inicio" name="inicio" type="datetime-local" required value="<%= @values["inicio"] %>"<%= invalid(@errors, "inicio") %>>
        <%= field_errors(@errors, "inicio") %></div>
      <div><label for="fim">Devolução</label>
        <input id="fim" name="fim" type="datetime-local" required value="<%= @values["fim"] %>"<%= invalid(@errors, "fim") %>>
        <%= field_errors(@errors, "fim") %></div>
      <p class="full muted small">Horários no fuso da locadora (<%= time_zone.identifier %>).</p>
      <div class="full actions"><button type="submit" class="primary">Consultar</button></div>
    </form>
  <% end %>
</section>
<% if @result %>
  <section class="panel" aria-labelledby="resultado-titulo">
    <div class="panel-header">
      <h2 id="resultado-titulo">Itens no período <span class="count"><%= @result.size %></span></h2>
    </div>
    <% if @result.empty? %>
      <p class="empty">Nenhum item disponível para locação.</p>
    <% else %>
      <form method="post" action="/portal/reservas" class="stack">
        <%= csrf_field %><%= time_zone_field %>
        <input type="hidden" name="filial" value="<%= @values["filial"] %>">
        <input type="hidden" name="inicio" value="<%= @values["inicio"] %>">
        <input type="hidden" name="fim" value="<%= @values["fim"] %>">
        <div class="table-scroll">
          <table class="table">
            <caption class="sr-only">Disponibilidade dos itens no período informado</caption>
            <thead><tr><th scope="col">Item</th><th scope="col">Situação no período</th><th scope="col">Quantidade desejada</th></tr></thead>
            <tbody>
              <% @result.each_with_index do |row, index| %>
                <tr>
                  <td><strong><%= row.name %></strong><% if row.description %><span class="cell-sub"><%= row.description %></span><% end %></td>
                  <td>
                    <% if row.available %>
                      <%= badge(row.requested ? "Disponível para #{row.requested}" : "Disponível", "success") %>
                    <% else %>
                      <%= badge(row.requested ? "Indisponível para #{row.requested}" : "Indisponível", "danger") %>
                    <% end %>
                  </td>
                  <td>
                    <input type="hidden" name="produto[]" value="<%= row.product_id %>">
                    <label class="sr-only" for="quantidade-<%= index %>">Quantidade de <%= row.name %></label>
                    <input id="quantidade-<%= index %>" name="quantidade[]" type="number" min="0" max="100000" inputmode="numeric" placeholder="0" value="<%= row.requested %>"<%= invalid(@errors, "quantidade") %>>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= field_errors(@errors, "quantidade") %>
        <%= field_errors(@errors, "itens") %>
        <label for="observacoes">Observações para a locadora (opcional)</label>
        <textarea id="observacoes" name="observacoes" rows="3" maxlength="2000"><%= @values["observacoes"] %></textarea>
        <p class="notice" role="note"><strong>Atenção:</strong> <%= Locentra::Domain::Portal::REQUEST_NOTICE %></p>
        <button type="submit" class="primary">Enviar solicitação de reserva</button>
      </form>
    <% end %>
  </section>
<% end %>
