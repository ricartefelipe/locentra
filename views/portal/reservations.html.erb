<header class="page-header">
  <div>
    <h1>Minhas reservas</h1>
    <p class="page-meta"><span><%= count_text(@page.total, "reserva", "reservas") %></span><span>Solicitações feitas pelo portal ficam como "Solicitada" até a confirmação da locadora.</span></p>
  </div>
  <a class="button primary" href="/portal/disponibilidade">Solicitar reserva</a>
</header>
<form method="get" action="/portal/reservas" class="filters" role="search">
  <label for="situacao">Situação</label>
  <select id="situacao" name="situacao">
    <option value="">Todas</option>
    <% Locentra::Domain::Reservations::STATUSES.each do |key, label| %><option value="<%= key %>"<%= selected(@filter_status, key) %>><%= label %></option><% end %>
  </select>
  <button type="submit">Filtrar</button>
</form>
<% if @page.items.empty? %>
  <p class="empty">Nenhuma reserva encontrada. <a href="/portal/disponibilidade">Consulte a disponibilidade</a> para solicitar uma reserva.</p>
<% else %>
  <div class="table-scroll">
    <table class="table">
      <caption class="sr-only">Reservas</caption>
      <thead><tr><th scope="col">Código</th><th scope="col">Retirada</th><th scope="col">Devolução</th><th scope="col">Situação</th><th scope="col" class="num">Total</th></tr></thead>
      <tbody>
        <% @page.items.each do |row| %>
          <% r = row[:reservation] %>
          <tr>
            <td><a href="/portal/reservas/<%= r.id %>"><%= r.code %></a></td>
            <td><%= datetime(r.period.starts_at, "%d/%m/%Y") %><span class="cell-sub"><%= datetime(r.period.starts_at, "%H:%M") %></span></td>
            <td><%= datetime(r.period.ends_at, "%d/%m/%Y") %><span class="cell-sub"><%= datetime(r.period.ends_at, "%H:%M") %></span></td>
            <td><%= status_badge(r.status, r.status_label) %></td>
            <td class="num"><strong><%= money(r.total) %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<%= partial("shared/pagination", page: @page, base_path: "/portal/reservas", query: { "situacao" => @filter_status }) %>
