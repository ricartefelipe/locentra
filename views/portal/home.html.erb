<% d = @data %>
<header class="page-header">
  <h1><%= d[:customer].name %></h1>
  <div class="actions">
    <a class="button primary" href="/portal/disponibilidade">Consultar disponibilidade</a>
  </div>
  <p class="muted">Portal do cliente de <%= request.organization.name %>: acompanhe reservas, orçamentos, contratos e cobranças.</p>
</header>
<section class="cards" aria-label="Resumo">
  <a class="card" href="/portal/orcamentos?situacao=sent">
    <span class="card-value"><%= d[:quotes_total] %></span>
    <span class="card-label">Orçamentos aguardando sua decisão</span>
  </a>
  <a class="card" href="/portal/contratos?situacao=issued">
    <span class="card-value"><%= d[:contracts_total] %></span>
    <span class="card-label">Contratos aguardando aceite</span>
  </a>
  <a class="card<%= d[:totals][:open].positive? ? " card-alert" : "" %>" href="/portal/financeiro">
    <span class="card-value"><%= money(d[:totals][:open]) %></span>
    <span class="card-label">Em aberto (<%= d[:totals][:open_count] %> cobranças)</span>
  </a>
</section>
<div class="grid-2">
  <section class="panel" aria-labelledby="proximas-reservas">
    <h2 id="proximas-reservas">Próximas reservas</h2>
    <% if d[:reservations].empty? %>
      <p class="empty">Nenhuma reserva em andamento ou futura. <a href="/portal/disponibilidade">Solicite uma reserva</a>.</p>
    <% else %>
      <ul class="row-list">
        <% d[:reservations].each do |row| %>
          <% r = row[:reservation] %>
          <li><a href="/portal/reservas/<%= r.id %>"><%= r.code %></a> · <%= datetime(r.period.starts_at) %> a <%= datetime(r.period.ends_at) %> <%= status_badge(r.status, r.status_label) %></li>
        <% end %>
      </ul>
    <% end %>
  </section>
  <section class="panel" aria-labelledby="pendencias">
    <h2 id="pendencias">Pendências</h2>
    <% if d[:quotes].empty? && d[:contracts].empty? %>
      <p class="empty">Nenhum orçamento ou contrato aguardando você.</p>
    <% else %>
      <ul class="row-list">
        <% d[:quotes].each do |row| %>
          <li>Orçamento <a href="/portal/orcamentos/<%= row[:quote].id %>"><%= row[:quote].code %></a> · <%= money(row[:total]) %> · válido até <%= datetime(row[:valid_until]) %></li>
        <% end %>
        <% d[:contracts].each do |row| %>
          <li>Contrato <a href="/portal/contratos/<%= row[:contract].id %>"><%= row[:contract].code %></a> da reserva <%= row[:reservation_code] %> aguardando aceite</li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
