<% totals = @data[:totals] %>
<% receivables = @data[:receivables] %>
<% deposits = @data[:deposits] %>
<% receivables_query = @paging.slice("limite", "caucoes_limite", "caucoes_inicio") %>
<% deposits_query = @paging.slice("caucoes_limite", "limite", "inicio") %>
<header class="page-header">
  <div>
    <h1>Cobranças e saldos</h1>
    <p class="page-meta"><span>Saldos calculados a partir dos pagamentos confirmados, reembolsos e cauções aplicadas. Pagamentos em processamento aparecem depois da confirmação.</span></p>
  </div>
</header>
<section class="cards" aria-label="Totais">
  <div class="card<%= totals[:open].positive? ? " card-tone-danger" : " card-tone-success" %>">
    <span class="card-value"><%= money(totals[:open]) %></span>
    <span class="card-label">Em aberto (<%= totals[:open_count] %> cobranças)</span>
  </div>
  <div class="card<%= totals[:credit].positive? ? " card-tone-info" : "" %>">
    <span class="card-value"><%= money(totals[:credit]) %></span>
    <span class="card-label">Crédito a seu favor</span>
  </div>
</section>
<section class="panel" aria-labelledby="cobrancas-titulo">
  <div class="panel-header">
    <h2 id="cobrancas-titulo">Cobranças <span class="count"><%= receivables.total %></span></h2>
  </div>
  <% if receivables.total.zero? %>
    <p class="empty">Nenhuma cobrança registrada.</p>
  <% else %>
    <p class="muted small">Cobranças em aberto aparecem primeiro, das mais antigas para as mais recentes; em seguida, as demais.</p>
    <div class="table-scroll">
      <table class="table">
        <caption class="sr-only">Cobranças com valor, valor quitado e saldo</caption>
        <thead><tr><th scope="col">Descrição</th><th scope="col">Reserva</th><th scope="col">Vencimento</th><th scope="col">Situação</th><th scope="col" class="num">Valor</th><th scope="col" class="num">Quitado</th><th scope="col" class="num">Saldo</th></tr></thead>
        <tbody>
          <% receivables.items.each do |row| %>
            <% rec = row[:receivable] %>
            <% bal = row[:balance] %>
            <tr>
              <td><%= rec.description %><span class="cell-sub"><%= rec.kind_label %></span></td>
              <td><a href="/portal/reservas/<%= rec.reservation_id %>"><%= row[:reservation_code] %></a></td>
              <td><%= date(rec.due_on) %></td>
              <td><%= finance_badge(bal.status, bal.status_label) %></td>
              <td class="num"><%= money(rec.amount) %></td>
              <td class="num"><%= money(bal.settled) %></td>
              <td class="num"><strong><%= money(bal.status == "cancelled" ? Locentra::Domain::Money.zero : bal.open_amount) %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= partial("shared/pagination", page: receivables, base_path: "/portal/financeiro", query: receivables_query, label: "Paginação das cobranças") %>
  <% end %>
</section>
<section class="panel" aria-labelledby="caucoes-titulo">
  <div class="panel-header">
    <h2 id="caucoes-titulo">Cauções <span class="count"><%= deposits.total %></span></h2>
  </div>
  <% if deposits.total.zero? %>
    <p class="empty">Nenhuma caução registrada.</p>
  <% else %>
    <p class="muted small">Cauções com saldo retido aparecem primeiro. A caução é separada das cobranças: o saldo retido é devolvido após a conferência da devolução, deduzidos os valores aplicados.</p>
    <div class="table-scroll">
      <table class="table">
        <caption class="sr-only">Cauções com valores previsto, recebido, aplicado, devolvido e retido</caption>
        <thead><tr><th scope="col">Reserva</th><th scope="col">Tipo</th><th scope="col">Situação</th><th scope="col" class="num">Prevista</th><th scope="col" class="num">Recebida</th><th scope="col" class="num">Aplicada</th><th scope="col" class="num">Devolvida</th><th scope="col" class="num">Retida</th></tr></thead>
        <tbody>
          <% deposits.items.each do |row| %>
            <% dep = row[:deposit] %>
            <% led = row[:ledger] %>
            <tr>
              <td><a href="/portal/reservas/<%= dep.reservation_id %>"><%= row[:reservation_code] %></a></td>
              <td><%= dep.kind_label %></td>
              <td><%= finance_badge(led.status, led.status_label) %></td>
              <td class="num"><%= money(dep.expected) %></td>
              <td class="num"><%= money(led.received) %></td>
              <td class="num"><%= money(led.applied) %></td>
              <td class="num"><%= money(led.returned) %></td>
              <td class="num"><strong><%= money(led.balance) %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= partial("shared/pagination", page: deposits, base_path: "/portal/financeiro", query: deposits_query, offset_param: "caucoes_inicio",
                                     label: "Paginação das cauções") %>
  <% end %>
</section>
