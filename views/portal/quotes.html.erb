<header class="page-header">
  <h1>Orçamentos</h1>
  <p class="muted">Orçamentos enviados pela locadora. A aprovação vale para a versão atual, dentro da validade.</p>
</header>
<form method="get" action="/portal/orcamentos" class="filters" role="search">
  <label for="situacao">Situação</label>
  <select id="situacao" name="situacao">
    <option value="">Todas</option>
    <% Locentra::Domain::Quotes::STATUSES.except("draft").each do |key, label| %><option value="<%= key %>"<%= selected(@filter_status, key) %>><%= label %></option><% end %>
  </select>
  <button type="submit">Filtrar</button>
</form>
<% if @page.items.empty? %>
  <p class="empty">Nenhum orçamento recebido.</p>
<% else %>
  <table class="table">
    <thead><tr><th scope="col">Código</th><th scope="col">Período</th><th scope="col">Validade</th><th scope="col">Situação</th><th scope="col" class="num">Total</th></tr></thead>
    <tbody>
      <% @page.items.each do |row| %>
        <% q = row[:quote] %>
        <tr>
          <td><a href="/portal/orcamentos/<%= q.id %>"><%= q.code %></a></td>
          <td><%= datetime(row[:period].starts_at) %> a <%= datetime(row[:period].ends_at) %></td>
          <td><%= datetime(row[:valid_until]) %><% if q.status == "sent" && row[:valid_until] <= @now %> <%= badge("vencida", "danger") %><% end %></td>
          <td><%= q.status == "draft" ? badge("Em revisão pela locadora", "neutral") : status_badge(q.status, q.status_label) %></td>
          <td class="num"><%= money(row[:total]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
<%= partial("shared/pagination", page: @page, base_path: "/portal/orcamentos", query: { "situacao" => @filter_status }) %>
