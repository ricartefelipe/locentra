<% statuses = Locentra::Domain::Transfers::STATUSES %>
<% editable = can?("assets.write") %>
<header class="page-header">
  <h1>Transferências entre filiais</h1>
  <p>O item em trânsito não fica disponível em nenhuma filial; o ativo só muda de filial no recebimento.</p>
</header>
<%= partial("shared/errors") %>
<% if editable && @branches.size < 2 %>
  <p class="empty">Cadastre outra filial em <a href="/organizacao">Organização</a> para transferir itens.</p>
<% elsif editable %>
  <div class="grid-2">
    <section class="panel" aria-labelledby="h-ativo">
      <h2 id="h-ativo">Transferir ativo</h2>
      <form method="post" action="/transferencias" class="stack">
        <%= csrf_field %>
        <label for="patrimonio">Patrimônio</label>
        <input id="patrimonio" name="patrimonio" required autocomplete="off" value="<%= @values["patrimonio"] || @values["ativo"] %>">
        <label for="destino-ativo">Filial de destino</label>
        <select id="destino-ativo" name="destino_id"><%= branch_options(@branches, @values["destino_id"], active_only: true) %></select>
        <label for="obs-ativo">Observações</label><input id="obs-ativo" name="observacoes" maxlength="500">
        <p class="muted">A saída exige que o ativo não tenha reservas ou bloqueios futuros na origem.</p>
        <button type="submit" class="primary">Solicitar transferência</button>
      </form>
    </section>
    <section class="panel" aria-labelledby="h-estoque">
      <h2 id="h-estoque">Transferir estoque</h2>
      <% if @products.empty? %>
        <p class="empty">Nenhum produto de estoque quantitativo cadastrado.</p>
      <% else %>
        <form method="post" action="/transferencias" class="stack">
          <%= csrf_field %>
          <label for="produto_id">Produto</label>
          <select id="produto_id" name="produto_id"><% @products.each do |p| %><option value="<%= p.id %>"<%= selected(@values["produto_id"], p.id) %>><%= p.name %> (<%= p.sku %>)</option><% end %></select>
          <label for="origem_id">Filial de origem</label>
          <select id="origem_id" name="origem_id"><%= branch_options(@branches, @values["origem_id"], active_only: false) %></select>
          <label for="destino-estoque">Filial de destino</label>
          <select id="destino-estoque" name="destino_id"><%= branch_options(@branches, @values["destino_id"], active_only: true) %></select>
          <label for="quantidade">Quantidade</label><input id="quantidade" name="quantidade" type="number" min="1" required value="<%= @values["quantidade"] %>">
          <p class="muted">A quantidade sai da origem na saída, respeitando as reservas futuras, e entra no destino no recebimento.</p>
          <button type="submit">Solicitar transferência</button>
        </form>
      <% end %>
    </section>
  </div>
<% end %>
<section class="panel" aria-labelledby="h-andamento">
  <h2 id="h-andamento">Em andamento</h2>
  <% if @active.empty? %>
    <p class="empty">Nenhuma transferência em andamento.</p>
  <% else %>
    <table class="table">
      <thead><tr><th scope="col">Código</th><th scope="col">Item</th><th scope="col">Origem → destino</th><th scope="col">Situação</th><th scope="col">Ações</th></tr></thead>
      <tbody>
        <% @active.each do |t| %>
          <tr>
            <td><%= t["code"] %><br><span class="muted"><%= datetime(t["requested_at"]) %></span></td>
            <td><%= t["product_name"] %> <span class="muted"><%= t["tag"] || "#{t["quantity"]} un." %></span><% if t["notes"] %><br><span class="muted"><%= t["notes"] %></span><% end %></td>
            <td><%= t["from_name"] %> → <%= t["to_name"] %></td>
            <td><%= status_badge(t["status"], statuses.fetch(t["status"])) %><% if t["dispatched_at"] %><br><span class="muted">saída <%= datetime(t["dispatched_at"]) %></span><% end %></td>
            <td>
              <% if editable && t["status"] == "requested" %>
                <form method="post" action="/transferencias/<%= t["id"] %>/saida" class="inline"><%= csrf_field %><button type="submit">Registrar saída</button></form>
                <details>
                  <summary>Cancelar</summary>
                  <form method="post" action="/transferencias/<%= t["id"] %>/cancelar" class="stack">
                    <%= csrf_field %>
                    <label for="motivo-<%= t["id"] %>">Motivo</label><input id="motivo-<%= t["id"] %>" name="motivo" required maxlength="500">
                    <button type="submit" class="danger">Cancelar transferência</button>
                  </form>
                </details>
              <% elsif editable && t["status"] == "in_transit" %>
                <form method="post" action="/transferencias/<%= t["id"] %>/recebimento" class="inline"><%= csrf_field %><button type="submit" class="primary">Registrar recebimento</button></form>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
<section class="panel" aria-labelledby="h-encerradas">
  <h2 id="h-encerradas">Encerradas</h2>
  <% if @closed.empty? %>
    <p class="empty">Nenhuma transferência encerrada.</p>
  <% else %>
    <ul class="row-list">
      <% @closed.each do |t| %>
        <li><strong><%= t["code"] %></strong> <%= t["product_name"] %> <%= t["tag"] || "#{t["quantity"]} un." %> · <%= t["from_code"] %> → <%= t["to_code"] %>
          <%= status_badge(t["status"], statuses.fetch(t["status"])) %> <%= datetime(t["received_at"] || t["cancelled_at"]) %>
          <% if t["cancellation_reason"] %><span class="muted"><%= t["cancellation_reason"] %></span><% end %></li>
      <% end %>
    </ul>
  <% end %>
</section>
