<header class="page-header">
  <h1>Ativos</h1>
  <p class="page-meta"><span><% if @assets.size >= 100 %>Primeiros <%= @assets.size %> ativos<% else %><%= count_text(@assets.size, "ativo", "ativos") %><% end %></span></p>
</header>
<section class="panel" aria-label="Lista de ativos">
  <form method="get" action="/ativos" class="filters">
    <label for="situacao">Situação</label>
    <select id="situacao" name="situacao"><option value="">Todas</option>
      <% Locentra::Domain::Catalog::ASSET_STATUSES.each do |k, l| %><option value="<%= k %>"<%= selected(@filter_status, k) %>><%= l %></option><% end %>
    </select>
    <button type="submit">Filtrar</button>
  </form>
  <% if @assets.empty? %><p class="empty">Nenhum ativo encontrado.</p><% else %>
    <div class="table-scroll">
      <table class="table">
        <caption class="sr-only">Lista de ativos</caption>
        <thead><tr><th scope="col">Patrimônio</th><th scope="col">Produto</th><th scope="col">Filial</th><th scope="col">Condição</th><th scope="col">Situação</th></tr></thead>
        <tbody>
          <% @assets.each do |a| %>
            <tr><td><a class="mono" href="/ativos/<%= a["id"] %>"><%= a["tag"] %></a><% if a["serial_number"] %><span class="cell-sub">Série <%= a["serial_number"] %></span><% end %></td>
              <td><%= a["product_name"] %><span class="cell-sub"><%= a["sku"] %></span></td>
              <td><%= a["branch_code"] %></td>
              <td><%= Locentra::Domain::Catalog::CONDITIONS[a["condition"]] %></td>
              <td><%= status_badge(a["status"], Locentra::Domain::Catalog::ASSET_STATUSES[a["status"]]) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
