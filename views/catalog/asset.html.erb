<% a = @data[:asset] %>
<% product = @data[:product] %>
<header class="page-header">
  <div>
    <a class="eyebrow" href="/ativos">Ativos</a>
    <h1>Ativo <%= a.tag %> <%= status_badge(a.status, a.status_label) %></h1>
  </div>
  <% if a.status == "available" %>
    <nav class="actions" aria-label="Operações do ativo">
      <% if can?("maintenance.write") %><a class="button" href="<%= url("/manutencao", "ativo" => a.tag) %>">Abrir ordem de manutenção</a><% end %>
      <% if can?("assets.write") %><a class="button" href="<%= url("/transferencias", "ativo" => a.tag) %>">Transferir para outra filial</a><% end %>
    </nav>
  <% end %>
  <p class="page-meta"><span><a href="/produtos/<%= product.id %>"><%= product.name %></a></span><span class="mono"><%= product.sku %></span><% if a.unavailable_until %><span>indisponível até <%= datetime(a.unavailable_until) %></span><% end %></p>
</header>
<%= partial("shared/errors") %>
<div class="detail-layout">
  <div class="detail-main">
    <section class="panel" aria-labelledby="alocacoes-titulo">
      <header class="panel-header"><h2 id="alocacoes-titulo">Alocações e bloqueios <span class="count"><%= @data[:allocations].size %></span></h2></header>
      <% if @data[:allocations].empty? %><p class="empty">Nenhuma alocação.</p><% else %>
        <div class="table-scroll">
          <table class="table">
            <caption class="sr-only">Alocações e bloqueios do ativo <%= a.tag %></caption>
            <thead><tr><th scope="col">Período bloqueado</th><th scope="col">Tipo</th><th scope="col">Reserva</th><th scope="col">Ativa</th></tr></thead>
            <tbody>
              <% @data[:allocations].each do |al| %>
                <tr><td><%= datetime(al["starts_at"]) %> → <%= datetime(al["ends_at"]) %></td>
                  <td><% if al["kind"] == "block" %>Bloqueio<span class="cell-sub"><%= al["reason"] %></span><% else %>Reserva<% end %></td>
                  <td><% if al["reservation_id"] %><a href="/reservas/<%= al["reservation_id"] %>"><%= al["reservation_code"] %></a><% else %>—<% end %></td>
                  <td><%= al["active"] ? badge("Ativa", "success") : badge("Encerrada", "muted") %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <% if can?("maintenance.write") %>
        <details<%= open_after_failure("/ativos/#{a.id}/bloqueios") %>>
          <summary>Bloquear período (preparação ou manutenção programada)</summary>
          <form method="post" action="/ativos/<%= a.id %>/bloqueios" class="form-grid">
            <%= csrf_field %><%= time_zone_field %>
            <div><label for="b-inicio">Início</label><input id="b-inicio" name="inicio" type="datetime-local" required></div>
            <div><label for="b-fim">Fim</label><input id="b-fim" name="fim" type="datetime-local" required></div>
            <div class="full"><label for="b-motivo">Motivo</label><input id="b-motivo" name="motivo" required></div>
            <div class="full actions"><button type="submit">Bloquear</button></div>
          </form>
        </details>
      <% end %>
    </section>
    <section class="panel" aria-labelledby="historico-ativo">
      <h2 id="historico-ativo">Histórico</h2>
      <% if @data[:events].empty? %><p class="empty">Sem eventos.</p><% else %>
        <ol class="timeline">
          <% @data[:events].each do |e| %>
            <li><time><%= datetime(e["occurred_at"]) %></time> <strong><%= label(:asset_event, e["kind"]) %></strong>
              <% if e["to_status"] %><%= e["from_status"] ? asset_status(e["from_status"]) : "—" %> → <%= asset_status(e["to_status"]) %><% end %> <span class="muted"><%= e["notes"] %></span></li>
          <% end %>
        </ol>
      <% end %>
    </section>
  </div>
  <aside class="detail-aside" aria-labelledby="situacao-titulo">
    <section class="panel">
      <h2 id="situacao-titulo">Situação operacional</h2>
      <dl class="details">
        <dt>Condição</dt><dd><%= a.condition_label %></dd>
        <dt>Patrimônio</dt><dd class="mono"><%= a.tag %></dd>
        <dt>Série</dt><dd><% if a.serial_number %><span class="mono"><%= a.serial_number %></span><% else %>—<% end %></dd>
        <% if a.unavailable_until %><dt>Indisponível até</dt><dd><%= datetime(a.unavailable_until) %></dd><% end %>
        <% if a.acquired_on %><dt>Aquisição</dt><dd><%= date(a.acquired_on) %></dd><% end %>
        <% if a.acquisition_cost && a.acquisition_cost.cents.positive? %><dt>Custo de aquisição</dt><dd><%= money(a.acquisition_cost) %></dd><% end %>
      </dl>
      <% managed = Locentra::Application::Catalog::ChangeAssetStatus::MANAGED[a.status] %>
      <% if can?("assets.write") && managed %>
        <p class="notice" role="status">Situação controlada pela operação: <%= managed %>.</p>
      <% elsif can?("assets.write") %>
        <h3>Alterar situação</h3>
        <form method="post" action="/ativos/<%= a.id %>/situacao" class="stack">
          <%= csrf_field %><%= time_zone_field %>
          <label for="situacao">Nova situação</label>
          <select id="situacao" name="situacao">
            <% Locentra::Domain::Catalog::ASSET_TRANSITIONS.fetch(a.status).select { |s| Locentra::Application::Catalog::ChangeAssetStatus::TARGETS.include?(s) }.each do |s| %>
              <option value="<%= s %>"><%= Locentra::Domain::Catalog::ASSET_STATUSES[s] %></option>
            <% end %>
          </select>
          <label for="indisponivel_ate">Indisponível até (opcional)</label><input id="indisponivel_ate" name="indisponivel_ate" type="datetime-local">
          <label for="motivo">Motivo</label><input id="motivo" name="motivo">
          <p class="muted small">Reservas futuras deste ativo são transferidas para outra unidade livre; sem substituto, a operação é recusada.</p>
          <button type="submit">Atualizar situação</button>
        </form>
      <% end %>
    </section>
  </aside>
</div>
