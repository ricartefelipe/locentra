<% p = @data[:product] %>
<% table = p.pricing %>
<% tiers = Array(table["quantity_tiers"]) %>
<header class="page-header">
  <div>
    <a class="eyebrow" href="/produtos">Produtos e kits</a>
    <h1><%= p.name %></h1>
  </div>
  <p class="page-meta"><span class="mono"><%= p.sku %></span><span><%= badge(p.tracking_label, p.kit? ? "violet" : (p.serialized? ? "info" : "neutral")) %></span><% if p.category %><span><%= p.category %></span><% end %></p>
</header>
<%= partial("shared/errors") %>
<div class="detail-layout">
  <div class="detail-main">
    <% if p.serialized? %>
      <section class="panel" aria-labelledby="ativos-titulo">
        <header class="panel-header"><h2 id="ativos-titulo">Ativos individuais <span class="count"><%= @data[:assets].size %></span></h2></header>
        <% if @data[:assets].empty? %><p class="empty">Nenhum ativo cadastrado.</p><% else %>
          <div class="table-scroll">
            <table class="table">
              <caption class="sr-only">Ativos de <%= p.name %></caption>
              <thead><tr><th scope="col">Patrimônio</th><th scope="col">Série</th><th scope="col">Condição</th><th scope="col">Situação</th></tr></thead>
              <tbody>
                <% @data[:assets].each do |a| %>
                  <tr><td><a class="mono" href="/ativos/<%= a.id %>"><%= a.tag %></a></td><td><% if a.serial_number %><span class="mono"><%= a.serial_number %></span><% else %>—<% end %></td><td><%= a.condition_label %></td>
                    <td><%= status_badge(a.status, a.status_label) %></td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
        <% if can?("assets.write") %>
          <details<%= open_after_failure("/produtos/#{p.id}/ativos") %>>
            <summary>Cadastrar ativo</summary>
            <form method="post" action="/produtos/<%= p.id %>/ativos" class="form-grid">
              <%= csrf_field %>
              <div><label for="patrimonio">Patrimônio</label><input id="patrimonio" name="patrimonio" required></div>
              <div><label for="numero_serie">Número de série</label><input id="numero_serie" name="numero_serie"></div>
              <div><label for="filial_id">Filial</label>
                <select id="filial_id" name="filial_id"><%= branch_options(@branches, nil, active_only: true) %></select></div>
              <div><label for="condicao">Condição</label>
                <select id="condicao" name="condicao"><% Locentra::Domain::Catalog::CONDITIONS.each do |k, l| %><option value="<%= k %>"<%= selected("good", k) %>><%= l %></option><% end %></select></div>
              <div><label for="custo_aquisicao">Custo de aquisição (R$)</label><input id="custo_aquisicao" name="custo_aquisicao" inputmode="decimal"<%= invalid(@errors, "custo_aquisicao") %>><%= field_errors(@errors, "custo_aquisicao") %></div>
              <div><label for="data_aquisicao">Data de aquisição</label><input id="data_aquisicao" name="data_aquisicao" type="date"></div>
              <div class="full actions"><button type="submit">Cadastrar ativo</button></div>
            </form>
          </details>
        <% end %>
      </section>
    <% elsif p.bulk? %>
      <section class="panel" aria-labelledby="estoque-titulo">
        <header class="panel-header"><h2 id="estoque-titulo">Estoque quantitativo por filial</h2></header>
        <% if @data[:pools].empty? %><p class="empty">Sem estoque registrado.</p><% else %>
          <div class="table-scroll">
            <table class="table">
              <caption class="sr-only">Estoque de <%= p.name %> por filial</caption>
              <thead><tr><th scope="col">Filial</th><th scope="col" class="num">Unidades</th></tr></thead>
              <tbody>
                <% @data[:pools].each do |pool| %><tr><td><strong><%= pool["branch_name"] %></strong></td><td class="num"><%= pool["total_quantity"] %></td></tr><% end %>
              </tbody>
            </table>
          </div>
        <% end %>
        <% if can?("assets.write") %>
          <h3>Registrar movimento</h3>
          <form method="post" action="/produtos/<%= p.id %>/estoque" class="form-grid">
            <%= csrf_field %>
            <div><label for="filial_id">Filial</label>
              <select id="filial_id" name="filial_id" aria-describedby="ajuda-estoque-filial"><%= branch_options(@branches, nil, active_only: false) %></select>
              <p class="muted small" id="ajuda-estoque-filial">Filiais inativas aceitam somente baixa e perda.</p></div>
            <div><label for="movimento">Movimento</label>
              <select id="movimento" name="movimento"><option value="acquisition">Entrada</option><option value="write_off">Baixa</option><option value="loss">Perda</option></select></div>
            <div><label for="quantidade">Quantidade</label><input id="quantidade" name="quantidade" type="number" min="1" required></div>
            <div><label for="motivo">Motivo</label><input id="motivo" name="motivo"></div>
            <div class="full actions"><button type="submit">Registrar movimento</button></div>
          </form>
        <% end %>
      </section>
    <% else %>
      <section class="panel" aria-labelledby="kit-titulo">
        <header class="panel-header"><h2 id="kit-titulo">Composição do kit <span class="count"><%= @data[:components].size %></span></h2></header>
        <% if @data[:components].empty? %><p class="empty">Kit sem componentes.</p><% else %>
          <div class="table-scroll">
            <table class="table">
              <caption class="sr-only">Componentes de <%= p.name %></caption>
              <thead><tr><th scope="col">Componente</th><th scope="col">SKU</th><th scope="col" class="num">Quantidade</th></tr></thead>
              <tbody>
                <% @data[:components].each do |c| %><tr><td><a href="/produtos/<%= c["product_id"] %>"><%= c["name"] %></a></td><td><span class="mono"><%= c["sku"] %></span></td><td class="num"><%= c["quantity"] %></td></tr><% end %>
              </tbody>
            </table>
          </div>
        <% end %>
        <% if can?("catalog.write") %>
          <h3>Editar composição</h3>
          <form method="post" action="/produtos/<%= p.id %>/componentes" class="stack">
            <%= csrf_field %>
            <% rows = [@data[:components].size + 1, 3].max %>
            <% rows.times do |i| %>
              <% current = @data[:components][i] %>
              <div class="line">
                <label for="componente-<%= i %>">Componente</label>
                <select id="componente-<%= i %>" name="componente[]"><option value="">—</option>
                  <% @candidates.each do |c| %><option value="<%= c.id %>"<%= selected(current && current["product_id"], c.id) %>><%= c.name %></option><% end %>
                </select>
                <label for="qtd-<%= i %>">Qtd.</label><input id="qtd-<%= i %>" name="quantidade[]" type="number" min="1" value="<%= current && current["quantity"] %>">
              </div>
            <% end %>
            <button type="submit">Salvar composição</button>
          </form>
        <% end %>
      </section>
    <% end %>
    <section class="panel" aria-labelledby="precos-titulo">
      <h2 id="precos-titulo">Tabela de preços</h2>
      <% if table.empty? %><p class="empty">Sem tabela de preços.</p><% else %>
        <dl class="details">
          <% if table["hourly_cents"] %><dt>Hora</dt><dd><%= money(table["hourly_cents"]) %></dd><% end %>
          <% if table["daily_cents"] %><dt>Diária</dt><dd><%= money(table["daily_cents"]) %><span class="cell-sub"><%= Locentra::Domain::Pricing::DAILY_MODES[table["daily_mode"]] %></span></dd><% end %>
          <% if table["weekly_cents"] %><dt>Semana</dt><dd><%= money(table["weekly_cents"]) %></dd><% end %>
          <dt>Mínimo</dt><dd><%= table["minimum_minutes"].to_i %> min</dd>
          <dt>Tolerância</dt><dd><%= table["grace_minutes"].to_i %> min</dd>
          <% unless tiers.empty? %>
            <dt>Faixas por quantidade</dt>
            <dd><% tiers.each do |tier| %><span class="cell-sub">a partir de <%= tier["min_quantity"] %> unidades: <%= percent(tier["discount_bps"].to_i) %> de desconto</span><% end %></dd>
          <% end %>
        </dl>
      <% end %>
      <% if can?("catalog.write") %>
        <details<%= open_after_failure("/produtos/#{p.id}/precos") %>>
          <summary>Alterar tabela de preços</summary>
          <form method="post" action="/produtos/<%= p.id %>/precos" class="form-grid">
            <%= csrf_field %>
            <%= partial("catalog/pricing_fields", table: table, values: {}, deposit: p.deposit.to_decimal_string) %>
            <div class="full actions"><button type="submit">Salvar preços</button></div>
          </form>
        </details>
      <% end %>
    </section>
  </div>
  <aside class="detail-aside" aria-labelledby="resumo-produto">
    <section class="panel">
      <h2 id="resumo-produto">Resumo</h2>
      <dl class="details">
        <% if p.serialized? %>
          <dt>Ativos</dt><dd><%= @data[:assets].size %></dd>
          <dt>Disponíveis</dt><dd><%= @data[:assets].count { |a| a.status == "available" } %></dd>
        <% elsif p.bulk? %>
          <dt>Unidades em estoque</dt><dd><%= @data[:pools].sum { |pool| pool["total_quantity"].to_i } %></dd>
        <% else %>
          <dt>Componentes</dt><dd><%= @data[:components].size %></dd>
        <% end %>
        <dt>Caução por unidade</dt><dd><%= money(p.deposit) %></dd>
        <dt>Custo de reposição</dt><dd><%= money(p.replacement_cost) %></dd>
        <dt>Preparação antes</dt><dd><%= p.buffer_before_minutes %> min</dd>
        <dt>Preparação depois</dt><dd><%= p.buffer_after_minutes %> min</dd>
      </dl>
      <% if table["daily_cents"] %>
        <p class="amount"><span class="amount-label">Diária</span><strong><%= money(table["daily_cents"]) %></strong></p>
      <% end %>
      <% if p.description %>
        <h3>Descrição</h3>
        <p class="pre"><%= p.description %></p>
      <% end %>
    </section>
  </aside>
</div>
