<%# Anexos de um cadastro. Locais: attachments, owner_type, owner_id, can_upload. %>
<%# Sem anexos: aviso e depois o envio. Com anexos: envio e depois a tabela, que fecha o painel. %>
<section class="panel" aria-labelledby="anexos-<%= @owner_id %>">
  <h2 id="anexos-<%= @owner_id %>">Anexos <span class="count"><%= @attachments.size %></span></h2>
  <% if @attachments.empty? %><p class="empty">Nenhum anexo.</p><% end %>
  <% if @can_upload %>
    <form method="post" action="/anexos" enctype="multipart/form-data" class="filters">
      <%= csrf_field %>
      <input type="hidden" name="dono_tipo" value="<%= @owner_type %>">
      <input type="hidden" name="dono_id" value="<%= @owner_id %>">
      <label for="arquivo-<%= @owner_id %>">Arquivo (PDF, PNG, JPEG ou WebP)</label>
      <input id="arquivo-<%= @owner_id %>" name="arquivo" type="file" accept="application/pdf,image/png,image/jpeg,image/webp" required>
      <button type="submit">Enviar</button>
    </form>
  <% end %>
  <% unless @attachments.empty? %>
    <div class="table-scroll">
      <table class="table">
        <thead><tr><th scope="col">Arquivo</th><th scope="col">Tipo</th><th scope="col" class="num">Tamanho</th><th scope="col">Enviado em</th></tr></thead>
        <tbody>
          <% @attachments.each do |a| %>
            <tr>
              <td><a href="/anexos/<%= a["id"] %>"><%= a["filename"] %></a><span class="cell-sub">SHA-256 <code class="small"><%= a["sha256"][0, 12] %>…</code></span></td>
              <td class="muted"><%= a["content_type"] %></td>
              <td class="num"><%= (a["byte_size"] / 1024.0).ceil %> KB</td>
              <td><%= datetime(a["created_at"]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
