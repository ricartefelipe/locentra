<%# Local opcional: compact (telas de uma só reserva: cobrança, caução e painel da reserva), que omite a coluna da reserva. %>
<% fin = Locentra::Domain::Finance %>
<% if @rows.empty? %>
  <p class="empty">Nenhum pagamento registrado.</p>
<% else %>
  <div class="table-scroll">
    <table class="table">
      <caption class="sr-only">Pagamentos</caption>
      <thead>
        <tr><th scope="col">Registrado em</th><% unless @compact %><th scope="col">Reserva</th><% end %><th scope="col">Finalidade</th><th scope="col">Método</th><th scope="col" class="num">Valor</th><th scope="col">Situação</th></tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <% payment = row[:payment] %>
          <tr>
            <td><a href="/financeiro/pagamentos/<%= payment.id %>"><%= datetime(row[:created_at]) %></a></td>
            <% unless @compact %><td><a href="/reservas/<%= payment.reservation_id %>"><%= row[:reservation_code] %></a></td><% end %>
            <td><%= fin::PAYMENT_PURPOSES.fetch(payment.purpose) %></td>
            <td><%= payment.method_label %><span class="cell-sub"><%= payment.provider_label %></span></td>
            <td class="num"><strong><%= money(payment.amount) %></strong></td>
            <td><%= finance_badge(payment.status, payment.status_label) %><% if payment.requires_review %> <%= badge("Revisão", "danger") %><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
