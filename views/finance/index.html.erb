<% fin = Locentra::Domain::Finance %>
<% totals = @data[:totals] %>
<% held_deposits = -@data[:trial_balance]["deposit_liability"] %>
<% alerts = @data[:alerts] %>
<header class="page-header">
  <h1>Financeiro</h1>
  <% if can?("integrations.manage") %>
    <div class="actions"><a class="button" href="/financeiro/provedor">Provedor de pagamentos</a></div>
  <% end %>
  <p class="muted">Cobranças, pagamentos, reembolsos, cauções e conciliação com o provedor.</p>
</header>
<%= partial("shared/errors") %>
<section class="cards" aria-label="Resumo financeiro">
  <a class="card<%= totals[:open].positive? ? " card-tone-warning" : "" %>" href="#titulo-cobrancas"><span class="card-value"><%= money(totals[:open]) %></span><span class="card-label">A receber</span><span class="card-foot"><%= count_text(totals[:open_count], "cobrança em aberto", "cobranças em aberto") %></span></a>
  <div class="card<%= totals[:credit].positive? ? " card-tone-danger" : "" %>"><span class="card-value"><%= money(totals[:credit]) %></span><span class="card-label">Créditos de clientes a reembolsar</span><span class="card-foot">Pago acima do valor cobrado</span></div>
  <a class="card<%= held_deposits.positive? ? " card-tone-info" : "" %>" href="#titulo-caucoes"><span class="card-value"><%= money(held_deposits) %></span><span class="card-label">Cauções retidas</span><span class="card-foot">Valor de clientes sob guarda (passivo), fora da receita</span></a>
  <% if alerts.empty? %>
    <div class="card card-tone-success"><span class="card-value">0</span><span class="card-label">Alertas para decisão</span><span class="card-foot">Nenhum alerta financeiro em aberto.</span></div>
  <% else %>
    <a class="card card-alert" href="#titulo-alertas"><span class="card-value"><%= alerts.size %></span><span class="card-label">Alertas para decisão</span><span class="card-foot">Exigem uma decisão registrada</span></a>
  <% end %>
</section>
<% unless alerts.empty? %><%= partial("finance/alerts", alerts: alerts) %><% end %>
<section class="panel" aria-labelledby="titulo-cobrancas">
  <header class="panel-header">
    <h2 id="titulo-cobrancas">Cobranças<span class="count"><%= @data[:receivables].total %></span></h2>
  </header>
  <form method="get" action="/financeiro" class="filters" role="search">
    <label for="situacao">Situação</label>
    <select id="situacao" name="situacao">
      <option value="">Todas</option>
      <% fin::RECEIVABLE_STATUSES.each do |key, label| %><option value="<%= key %>"<%= selected(@filter_status, key) %>><%= label %></option><% end %>
    </select>
    <button type="submit" class="small">Filtrar</button>
  </form>
  <%= partial("finance/receivables_table", rows: @data[:receivables].items) %>
  <%= partial("shared/pagination", page: @data[:receivables], base_path: "/financeiro", query: { "situacao" => @filter_status }) %>
</section>
<section class="panel" aria-labelledby="titulo-pagamentos">
  <header class="panel-header">
    <h2 id="titulo-pagamentos">Pagamentos recentes<span class="count"><%= @data[:payments].size %></span></h2>
  </header>
  <%= partial("finance/payments_table", rows: @data[:payments]) %>
</section>
<section class="panel" aria-labelledby="titulo-caucoes">
  <header class="panel-header">
    <h2 id="titulo-caucoes">Cauções retidas<span class="count"><%= @data[:deposits].size %></span></h2>
  </header>
  <% if @data[:deposits].empty? %><p class="empty">Nenhuma caução com saldo retido.</p><% else %>
    <div class="table-scroll">
      <table class="table">
        <caption class="sr-only">Cauções com saldo retido</caption>
        <thead><tr><th scope="col">Reserva</th><th scope="col" class="num">Recebido</th><th scope="col" class="num">Aplicado</th><th scope="col" class="num">Devolvido</th><th scope="col" class="num">Saldo</th></tr></thead>
        <tbody>
          <% @data[:deposits].each do |row| %>
            <tr>
              <td><a href="/financeiro/caucoes/<%= row[:deposit].id %>"><%= row[:reservation_code] %></a><span class="cell-sub"><%= row[:customer_name] %></span></td>
              <td class="num"><%= money(row[:ledger].received) %></td>
              <td class="num"><%= money(row[:ledger].applied) %></td>
              <td class="num"><%= money(row[:ledger].returned) %></td>
              <td class="num"><strong><%= money(row[:ledger].balance) %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
<div class="grid-2">
  <section class="panel" aria-labelledby="titulo-conciliacao">
    <% account = @data[:account] %>
    <header class="panel-header">
      <h2 id="titulo-conciliacao">Conciliação com o provedor</h2>
      <% if account && can?("finance.write") %>
        <form method="post" action="/financeiro/conciliacao"><%= csrf_field %><button type="submit" class="primary small">Conciliar agora</button></form>
      <% end %>
    </header>
    <% if account %>
      <dl class="details">
        <dt>Conta ativa</dt><dd><strong><%= account["name"] %></strong></dd>
        <dt>Provedor</dt><dd><%= fin::PROVIDERS.fetch(account["provider"]) %><% if account["provider"] == "asaas" %> <%= badge(label(:environment, account["environment"]), account["environment"] == "production" ? "success" : "warning") %><% end %></dd>
      </dl>
    <% else %>
      <p class="empty">Nenhum provedor de pagamentos configurado. Pagamentos podem ser registrados manualmente.</p>
    <% end %>
    <% if @data[:reports].empty? %><p class="empty">Nenhuma conciliação executada.</p><% else %>
      <h3>Execuções recentes</h3>
      <ul class="agenda">
        <% @data[:reports].each do |report| %>
          <li>
            <a class="agenda-row" href="/financeiro/conciliacao/<%= report["id"] %>">
              <span class="agenda-when"><strong><%= datetime(report["started_at"], "%H:%M") %></strong><span><%= datetime(report["started_at"], "%d/%m/%Y") %></span></span>
              <span class="agenda-main">
                <% if report["status"] == "completed" %>
                  <strong><%= count_text(report["summary"]["discrepancies"], "divergência", "divergências") %></strong><span class="muted"><%= count_text(report["summary"]["checked"], "pagamento verificado", "pagamentos verificados") %></span>
                <% else %>
                  <strong>Sem resumo</strong><span class="muted">Execução não concluída</span>
                <% end %>
              </span>
              <span class="agenda-side"><%= finance_badge(report["status"], { "running" => "Em execução", "completed" => "Concluída", "failed" => "Falhou" }.fetch(report["status"])) %></span>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if account %><p class="muted small">A conciliação também é executada a cada hora pelo worker.</p><% end %>
  </section>
  <section class="panel" aria-labelledby="titulo-diario">
    <header class="panel-header">
      <h2 id="titulo-diario">Diário contábil</h2>
    </header>
    <table class="table">
      <caption class="sr-only">Saldo por conta: débitos menos créditos</caption>
      <thead><tr><th scope="col">Conta</th><th scope="col" class="num">Débitos − créditos</th></tr></thead>
      <tbody>
        <% @data[:trial_balance].each do |account_key, total| %>
          <tr><td><%= fin::ACCOUNTS.fetch(account_key) %></td><td class="num"><%= money(total) %></td></tr>
        <% end %>
      </tbody>
    </table>
    <p class="muted small">Lançamentos somente de inserção, balanceados por transação. Faturas emitidas são demonstrativos comerciais: a emissão de NFS-e não é feita pelo Locentra.</p>
  </section>
</div>
