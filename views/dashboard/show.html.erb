<% labels = Locentra::Domain::Reservations::STATUSES %>
<% counts = @data[:reservations] %>
<% overdue = @data[:overdue] %>
<% tones = { "held" => "card-tone-warning", "confirmed" => "card-tone-violet", "in_progress" => "card-tone-info", "requested" => nil } %>
<% holds, pickups, returns = @data[:expiring_holds].size, @data[:upcoming].size, @data[:returns_due].size %>
<% feet = { "held" => holds.zero? ? "Nenhum expira na próxima hora" : "#{count_text(holds, "expira", "expiram")} na próxima hora",
            "confirmed" => pickups.zero? ? "Nenhuma retirada em 48 horas" : "#{count_text(pickups, "retirada", "retiradas")} em 48 horas",
            "in_progress" => returns.zero? ? "Nenhuma devolução em 24 horas" : "#{count_text(returns, "devolução", "devoluções")} em 24 horas",
            "requested" => "Aguardando análise" } %>
<header class="page-header">
  <div>
    <span class="eyebrow">Agenda operacional</span>
    <h1>Painel</h1>
    <p class="page-meta"><span>Hoje, <time><%= datetime(@data[:now], "%d/%m/%Y") %></time></span><span>Atualizado às <time><%= datetime(@data[:now], "%H:%M") %></time></span></p>
  </div>
  <div class="actions">
    <a class="button" href="/disponibilidade">Ver disponibilidade</a>
    <% if can?("reservations.write") %><a class="button primary" href="/reservas/nova">Nova reserva</a><% end %>
  </div>
</header>
<section class="cards" aria-label="Reservas por situação">
  <% %w[held confirmed in_progress requested].each do |status| %>
    <a class="<%= ["card", tones[status]].compact.join(" ") %>" href="/reservas?situacao=<%= status %>">
      <span class="card-value"><%= counts.fetch(status, 0) %></span>
      <span class="card-label"><%= labels[status] %></span>
      <span class="card-foot"><%= feet[status] %></span>
    </a>
  <% end %>
  <div class="card <%= overdue.empty? ? "card-tone-success" : "card-tone-danger" %>">
    <span class="card-value"><%= overdue.size %></span>
    <span class="card-label">Devoluções em atraso</span>
    <span class="card-foot"><%= overdue.empty? ? "Tudo dentro do prazo" : "Exige contato com o cliente" %></span>
  </div>
</section>
<div class="grid-2">
  <section class="panel" aria-labelledby="h-retiradas">
    <div class="panel-header">
      <h2 id="h-retiradas">Retiradas nas próximas 48 horas <span class="count"><%= @data[:upcoming].size %></span></h2>
      <% if can?("fulfillment.write") %><a class="button small ghost" href="/operacao">Abrir operação</a><% end %>
    </div>
    <%= partial("dashboard/list", rows: @data[:upcoming], column: :starts_at, empty: "Nenhuma retirada prevista.") %>
  </section>
  <section class="panel" aria-labelledby="h-devolucoes">
    <div class="panel-header">
      <h2 id="h-devolucoes">Devoluções previstas (24 horas) <span class="count"><%= @data[:returns_due].size %></span></h2>
      <% if can?("fulfillment.write") %><a class="button small ghost" href="/operacao">Abrir operação</a><% end %>
    </div>
    <%= partial("dashboard/list", rows: @data[:returns_due], column: :ends_at, empty: "Nenhuma devolução prevista.") %>
  </section>
  <section class="panel" aria-labelledby="h-atrasos">
    <div class="panel-header">
      <h2 id="h-atrasos">Em atraso <span class="count<%= " count-danger" unless overdue.empty? %>"><%= overdue.size %></span></h2>
    </div>
    <%= partial("dashboard/list", rows: overdue, column: :ends_at, empty: "Nenhuma locação em atraso.", late: true) %>
  </section>
  <section class="panel" aria-labelledby="h-bloqueios">
    <div class="panel-header">
      <h2 id="h-bloqueios">Bloqueios temporários expirando em 1 hora <span class="count<%= " count-warning" unless @data[:expiring_holds].empty? %>"><%= @data[:expiring_holds].size %></span></h2>
    </div>
    <%= partial("dashboard/list", rows: @data[:expiring_holds], column: :hold_expires_at, empty: "Nenhum bloqueio próximo de expirar.") %>
  </section>
</div>
<section class="panel" aria-labelledby="h-ativos">
  <div class="panel-header">
    <h2 id="h-ativos">Ativos por situação <span class="count"><%= @data[:assets].values.sum(&:to_i) %></span></h2>
    <% if can?("catalog.read") %><a class="button small ghost" href="/ativos">Ver ativos</a><% end %>
  </div>
  <% if @data[:assets].empty? %>
    <p class="empty"><span>Nenhum ativo individual cadastrado. <a href="/produtos">Cadastre produtos e ativos</a>.</span></p>
  <% else %>
    <ul class="inline-stats">
      <% @data[:assets].each do |status, total| %>
        <li><a href="/ativos?situacao=<%= status %>"><%= status_badge(status, Locentra::Domain::Catalog::ASSET_STATUSES.fetch(status, status)) %> <%= total %></a></li>
      <% end %>
    </ul>
  <% end %>
</section>
