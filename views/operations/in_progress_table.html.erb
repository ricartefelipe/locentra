<% if @rows.empty? %>
  <p class="empty"><%= @empty %></p>
<% else %>
  <ul class="agenda">
    <% @rows.each do |row| %>
      <li>
        <div class="agenda-row">
          <span class="agenda-when"><strong><time><%= datetime(row["ends_at"], "%H:%M") %></time></strong><span><%= datetime(row["ends_at"], "%d/%m") %></span></span>
          <span class="agenda-main">
            <a href="/reservas/<%= row["id"] %>"><strong><%= row["code"] %></strong></a>
            <span class="muted"><%= row["customer_name"] %></span>
            <% if row["overdue_since"] %><span><%= badge("Em atraso", "danger") %></span><% end %>
          </span>
          <span class="agenda-side"><% if can?("fulfillment.write") %><a class="button small" href="/operacao/reservas/<%= row["id"] %>/devolucao">Registrar devolução</a><% end %></span>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
