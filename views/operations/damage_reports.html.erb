<header class="page-header">
  <h1>Avarias e faltas</h1>
  <p>A cobrança é lançada na reserva somente após aprovação, com ao menos uma evidência anexada.</p>
</header>
<%= partial("operations/tabs", current: "/operacao/avarias") %>
<section class="panel" aria-labelledby="h-abertas">
  <div class="panel-header">
    <h2 id="h-abertas">Aguardando aprovação <span class="count<%= " count-warning" unless @open.empty? %>"><%= @open.size %></span></h2>
  </div>
  <%= partial("operations/damage_table", rows: @open, empty: "Nenhum registro aguardando aprovação.") %>
</section>
<section class="panel" aria-labelledby="h-decididas">
  <div class="panel-header">
    <h2 id="h-decididas">Decididos <span class="count"><%= @decided.size %></span></h2>
  </div>
  <%= partial("operations/damage_table", rows: @decided, empty: "Nenhum registro decidido.") %>
</section>
