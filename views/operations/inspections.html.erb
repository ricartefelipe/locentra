<% statuses = Locentra::Domain::Maintenance::INSPECTION_STATUSES %>
<% severities = Locentra::Domain::Maintenance::SEVERITIES %>
<header class="page-header">
  <h1>Inspeções</h1>
  <p>Itens em inspeção ficam indisponíveis para novas reservas até a aprovação. A reprovação abre ordem de manutenção.</p>
</header>
<%= partial("shared/errors") %>
<section class="panel" aria-labelledby="h-pendentes">
  <h2 id="h-pendentes">Pendentes</h2>
  <% if @pending.empty? %>
    <p class="empty">Nenhum item aguardando inspeção.</p>
  <% else %>
    <% @pending.each do |i| %>
      <article class="panel" aria-labelledby="insp-<%= i["id"] %>">
        <h3 id="insp-<%= i["id"] %>"><%= i["product_name"] %> <span class="muted"><%= i["tag"] || "#{i["quantity"]} un." %> · filial <%= i["branch_code"] %></span></h3>
        <p><%= i["reason"] %></p>
        <p class="muted">Desde <%= datetime(i["created_at"]) %><% if i["reservation_code"] %> · reserva <a href="/reservas/<%= i["reservation_id"] %>"><%= i["reservation_code"] %></a><% end %></p>
        <% if can?("inspections.write") %>
          <div class="grid-2">
            <form method="post" action="/operacao/inspecoes/<%= i["id"] %>/aprovar" class="stack">
              <%= csrf_field %>
              <label for="obs-<%= i["id"] %>">Observações da aprovação</label>
              <input id="obs-<%= i["id"] %>" name="observacoes" maxlength="1000">
              <button type="submit" class="primary">Aprovar e liberar</button>
            </form>
            <form method="post" action="/operacao/inspecoes/<%= i["id"] %>/reprovar" class="stack">
              <%= csrf_field %>
              <label for="motivo-<%= i["id"] %>">Motivo da reprovação</label>
              <input id="motivo-<%= i["id"] %>" name="motivo" required maxlength="1000">
              <label for="servico-<%= i["id"] %>">Serviço de manutenção (opcional)</label>
              <input id="servico-<%= i["id"] %>" name="servico" maxlength="2000">
              <button type="submit" class="danger">Reprovar e abrir manutenção</button>
            </form>
          </div>
          <% if i["return_line_id"] %>
            <details>
              <summary>Registrar avaria encontrada na inspeção</summary>
              <form method="post" action="/operacao/avarias" class="stack">
                <%= csrf_field %>
                <input type="hidden" name="item" value="<%= i["return_line_id"] %>">
                <label for="desc-<%= i["id"] %>">Descrição</label><textarea id="desc-<%= i["id"] %>" name="descricao" rows="2" required minlength="3" maxlength="2000"></textarea>
                <label for="sev-<%= i["id"] %>">Severidade</label>
                <select id="sev-<%= i["id"] %>" name="severidade"><% severities.each do |k, l| %><option value="<%= k %>"<%= selected("moderate", k) %>><%= l %></option><% end %></select>
                <label for="custo-<%= i["id"] %>">Custo estimado (R$)</label><input id="custo-<%= i["id"] %>" name="custo" inputmode="decimal">
                <button type="submit">Registrar avaria</button>
              </form>
            </details>
          <% end %>
        <% end %>
      </article>
    <% end %>
  <% end %>
</section>
<section class="panel" aria-labelledby="h-decididas">
  <h2 id="h-decididas">Decididas recentemente</h2>
  <% if @decided.empty? %>
    <p class="empty">Nenhuma inspeção decidida.</p>
  <% else %>
    <table class="table">
      <thead><tr><th scope="col">Item</th><th scope="col">Decisão</th><th scope="col">Em</th><th scope="col">Observações</th></tr></thead>
      <tbody>
        <% @decided.each do |i| %>
          <tr>
            <td><%= i["product_name"] %> <span class="muted"><%= i["tag"] || "#{i["quantity"]} un." %></span></td>
            <td><%= status_badge(i["status"], statuses.fetch(i["status"])) %>
              <% if i["maintenance_order_id"] %> · <a href="/manutencao/<%= i["maintenance_order_id"] %>"><%= i["maintenance_code"] %></a><% end %></td>
            <td><%= datetime(i["decided_at"]) %></td>
            <td><%= i["decision_notes"] || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
