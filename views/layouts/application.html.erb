<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title><%= @title %> · Locentra</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <script type="module" src="/js/app.js"></script>
</head>
<body class="app">
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <div class="app-shell">
    <aside class="app-sidebar" id="navegacao">
      <div class="sidebar-brand">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Locentra</a>
      </div>
      <% if request.organization %>
        <a class="org-switch" href="/organizacoes" title="Trocar organização">
          <span class="org-avatar" aria-hidden="true"><%= request.organization.name.to_s[0].to_s.upcase %></span>
          <span class="org-text"><span class="org-name"><%= request.organization.name %></span><span class="org-hint">Trocar organização</span></span>
        </a>
      <% end %>
      <nav class="sidebar" aria-label="Navegação principal">
        <% navigation_groups.each do |group, links| %>
          <p class="nav-group" aria-hidden="true"><%= group %></p>
          <ul aria-label="<%= group %>">
            <% links.each do |label, path| %>
              <li><a href="<%= path %>"<%= nav_class(path) %>><%= label %></a></li>
            <% end %>
          </ul>
        <% end %>
      </nav>
      <div class="sidebar-user">
        <% if session_user_name %>
          <span class="user-avatar" aria-hidden="true"><%= session_initials %></span>
          <span class="user-text"><span class="user-name"><%= session_user_name %></span><% if session_role_label %><span class="user-role"><%= session_role_label %></span><% end %></span>
        <% end %>
        <form method="post" action="/sair" class="inline user-logout">
          <%= csrf_field %>
          <button type="submit" class="link-button" title="Sair" aria-label="Sair"></button>
        </form>
      </div>
    </aside>
    <div class="nav-scrim" data-nav-close></div>
    <div class="app-main">
      <header class="mobile-bar">
        <button type="button" class="nav-toggle" data-nav-toggle aria-controls="navegacao" aria-expanded="false" aria-label="Abrir menu"></button>
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Locentra</a>
      </header>
      <% if request.email_confirmation && !request.email_confirmation.confirmed? %>
        <%= partial("shared/email_confirmation") %>
      <% end %>
      <main id="conteudo" class="content" tabindex="-1">
        <%= partial("shared/flash") %>
        <%= @content %>
      </main>
    </div>
  </div>
</body>
</html>
