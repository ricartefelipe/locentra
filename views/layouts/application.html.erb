<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @title %> · Locentra</title>
  <link rel="stylesheet" href="/css/app.css">
  <script type="module" src="/js/app.js"></script>
</head>
<body>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <header class="topbar">
    <a class="brand" href="/">Locentra</a>
    <% if request.organization %>
      <span class="org-name" title="Organização ativa"><%= request.organization.name %></span>
    <% end %>
    <nav class="topbar-actions" aria-label="Conta">
      <a href="/organizacoes">Trocar organização</a>
      <form method="post" action="/sair" class="inline">
        <%= csrf_field %>
        <button type="submit" class="link-button">Sair</button>
      </form>
    </nav>
  </header>
  <div class="shell">
    <nav class="sidebar" aria-label="Navegação principal">
      <ul>
        <% navigation.each do |label, path| %>
          <li><a href="<%= path %>"<%= nav_class(path) %>><%= label %></a></li>
        <% end %>
      </ul>
    </nav>
    <main id="conteudo" class="content" tabindex="-1">
      <%= partial("shared/flash") %>
      <%= @content %>
    </main>
  </div>
</body>
</html>
