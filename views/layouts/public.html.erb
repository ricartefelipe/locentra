<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title><%= @title %> · Locentra</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <script type="module" src="/js/app.js"></script>
</head>
<body class="public">
  <aside class="public-aside" aria-hidden="true">
    <span class="brand"><span class="brand-mark"></span>Locentra</span>
    <div class="public-pitch">
      <h2>Cada equipamento no lugar certo, na hora certa.</h2>
      <p>Orçamentos, reservas, contratos, retiradas e cobranças da sua locadora em um só lugar.</p>
      <ul class="public-points">
        <li>Disponibilidade em tempo real por filial</li>
        <li>Contratos com aceite eletrônico e PDF</li>
        <li>Caução, cobranças e conciliação integradas</li>
      </ul>
    </div>
    <p class="public-foot">Gestão de locações e ativos</p>
  </aside>
  <main id="conteudo" class="public-main">
    <p class="brand brand-large">Locentra</p>
    <p class="tagline">Gestão de locações e ativos</p>
    <%= partial("shared/flash") %>
    <%= @content %>
  </main>
</body>
</html>
