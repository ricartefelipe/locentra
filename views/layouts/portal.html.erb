<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title><%= @title %> · Portal do cliente · Locentra</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <script type="module" src="/js/app.js"></script>
</head>
<body class="portal">
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <div class="app-shell">
    <aside class="app-sidebar" id="navegacao">
      <div class="sidebar-brand">
        <a class="brand" href="/portal"><span class="brand-mark" aria-hidden="true"></span>Portal do cliente</a>
      </div>
      <% if request.organization %>
        <a class="org-switch" href="/organizacoes" title="Trocar acesso">
          <span class="org-avatar" aria-hidden="true"><%= request.organization.name.to_s[0].to_s.upcase %></span>
          <span class="org-text"><span class="org-name" title="Locadora"><%= request.organization.name %></span><span class="org-hint">Trocar acesso</span></span>
        </a>
      <% end %>
      <nav class="sidebar" aria-label="Navegação do portal">
        <ul>
          <% portal_navigation.each do |label, path| %>
            <li><a href="<%= path %>"<%= portal_nav_class(path) %>><%= label %></a></li>
          <% end %>
        </ul>
      </nav>
      <div class="sidebar-user">
        <% if session_user_name %>
          <span class="user-avatar" aria-hidden="true"><%= session_initials %></span>
          <span class="user-text"><span class="user-name"><%= session_user_name %></span><span class="user-role">Cliente</span></span>
        <% end %>
        <form method="post" action="/sair" class="inline user-logout">
          <%= csrf_field %>
          <button type="submit" class="link-button" title="Sair" aria-label="Sair"></button>
        </form>
      </div>
    </aside>
    <div class="nav-scrim" data-nav-close></div>
    <div class="app-main">
      <header class="mobile-bar">
        <button type="button" class="nav-toggle" data-nav-toggle aria-controls="navegacao" aria-expanded="false" aria-label="Abrir menu"></button>
        <a class="brand" href="/portal"><span class="brand-mark" aria-hidden="true"></span>Portal do cliente</a>
      </header>
      <main id="conteudo" class="content" tabindex="-1">
        <%= partial("shared/flash") %>
        <%= @content %>
      </main>
    </div>
  </div>
</body>
</html>
