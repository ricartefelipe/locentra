<header class="page-header">
  <h1>Orçamentos</h1>
  <% if can?("quotes.write") %><a class="button primary" href="/orcamentos/novo">Novo orçamento</a><% end %>
  <p class="muted">Orçamentos enviados sem bloqueio não garantem disponibilidade; ela é verificada na conversão em reserva.</p>
</header>
<section class="panel" aria-label="Lista de orçamentos">
  <form method="get" action="/orcamentos" class="filters" role="search">
    <label for="busca">Código ou cliente</label>
    <input id="busca" name="busca" type="search" value="<%= @search %>">
    <label for="situacao">Situação</label>
    <select id="situacao" name="situacao">
      <option value="">Todas</option>
      <% Locentra::Domain::Quotes::STATUSES.each do |key, label| %><option value="<%= key %>"<%= selected(@filter_status, key) %>><%= label %></option><% end %>
    </select>
    <button type="submit">Filtrar</button>
  </form>
  <% if @page.items.empty? %>
    <p class="empty">Nenhum orçamento encontrado.<% if can?("quotes.write") %> <a href="/orcamentos/novo">Crie o primeiro orçamento</a>.<% end %></p>
  <% else %>
    <div class="table-scroll">
      <table class="table">
        <thead><tr><th scope="col">Orçamento</th><th scope="col">Cliente</th><th scope="col">Período</th><th scope="col">Validade</th><th scope="col">Situação</th><th scope="col" class="num">Total</th></tr></thead>
        <tbody>
          <% @page.items.each do |row| %>
            <% q = row[:quote] %>
            <tr>
              <td><a href="/orcamentos/<%= q.id %>"><%= q.code %></a><span class="cell-sub">versão <%= q.current_version %></span></td>
              <td><%= row[:customer_name] %></td>
              <td><%= datetime(row[:period].starts_at) %><span class="cell-sub">até <%= datetime(row[:period].ends_at) %></span></td>
              <td><%= datetime(row[:valid_until]) %><% if q.status == "sent" && row[:valid_until] <= @now %> <%= badge("vencida", "danger") %><% end %></td>
              <td><%= status_badge(q.status, q.status_label) %></td>
              <td class="num"><%= money(row[:total]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
<%= partial("shared/pagination", page: @page, base_path: "/orcamentos", query: { "busca" => @search, "situacao" => @filter_status }) %>
