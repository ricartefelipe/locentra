<% q = @data[:quote] %>
<% v = @selected %>
<% current = @data[:current] %>
<header class="page-header">
  <h1>Orçamento <%= q.code %> <%= status_badge(q.status, q.status_label) %></h1>
  <p class="muted">Cliente: <a href="/clientes/<%= q.customer_id %>"><%= @data[:customer].name %></a> · versão atual <%= q.current_version %></p>
</header>
<%= partial("shared/errors") %>
<%= partial("shared/shortages") %>
<% if q.hold_on_send? %>
  <div class="notice" role="status">
    Política de bloqueio: <strong>bloqueio temporário ao enviar</strong> (<%= q.hold_minutes %> minutos).
    <% if @data[:hold] %>
      <% hold = @data[:hold] %>
      Reserva vinculada <a href="/reservas/<%= hold.id %>"><%= hold.code %></a> (<%= hold.status_label %><% if hold.held? %>, válida até <%= datetime(hold.hold_expires_at) %><% end %>).
      <% if hold.held? && !hold.hold_valid?(@now) %> O bloqueio venceu e a disponibilidade não está mais garantida.<% end %>
    <% else %>
      O bloqueio é criado no envio e garante a disponibilidade somente enquanto estiver vigente.
    <% end %>
  </div>
<% elsif %w[draft sent approved].include?(q.status) %>
  <div class="notice" role="status">Política de bloqueio: <strong>sem bloqueio</strong>. Este orçamento <strong>não garante disponibilidade</strong>; ela é verificada somente na conversão em reserva.</div>
<% end %>
<% if q.status == "sent" && current.expired?(@now) %>
  <div class="notice notice-danger" role="status">A validade da versão <%= current.number %> terminou em <%= datetime(current.valid_until) %>. Crie uma nova versão para renovar a proposta.</div>
<% end %>
<div class="grid-2">
  <section class="panel" aria-labelledby="versao-titulo">
    <h2 id="versao-titulo">Versão <%= v.number %><%= v.number == q.current_version ? " (atual)" : "" %></h2>
    <% if v.number != q.current_version %><p class="notice" role="status">Você está vendo uma versão anterior. <a href="/orcamentos/<%= q.id %>">Ver a versão atual</a>.</p><% end %>
    <dl class="details">
      <dt>Retirada</dt><dd><%= datetime(v.period.starts_at) %></dd>
      <dt>Devolução</dt><dd><%= datetime(v.period.ends_at) %></dd>
      <dt>Validade</dt><dd><%= datetime(v.valid_until) %><% if v.expired?(@now) %> <%= badge("vencida", "danger") %><% end %></dd>
      <dt>Criada em</dt><dd><%= datetime(v.created_at) %></dd>
      <dt>Condições</dt><dd class="pre"><%= v.terms || "—" %></dd>
    </dl>
    <table class="table">
      <caption class="sr-only">Itens da versão <%= v.number %></caption>
      <thead><tr><th scope="col">Item</th><th scope="col">Qtd.</th><th scope="col">Cobrança</th><th scope="col" class="num">Total</th></tr></thead>
      <tbody>
        <% v.items.each do |item| %>
          <tr><td><%= item["name"] %> <span class="muted"><%= item["sku"] %></span></td><td><%= item["quantity"] %></td><td><%= item["description"] %></td><td class="num"><%= money(item["total_cents"]) %></td></tr>
        <% end %>
      </tbody>
    </table>
    <dl class="details">
      <dt>Subtotal</dt><dd><%= money(v.pricing["subtotal_cents"].to_i) %></dd>
      <% if v.pricing["manual_discount_cents"].to_i.positive? %><dt>Desconto manual</dt><dd>−<%= money(v.pricing["manual_discount_cents"]) %></dd><% end %>
      <dt>Total</dt><dd><strong><%= money(v.total) %></strong></dd>
      <dt>Caução prevista</dt><dd><%= money(v.deposit) %></dd>
    </dl>
    <p class="muted">Preços calculados em <%= v.pricing["priced_at"] ? datetime(Time.iso8601(v.pricing["priced_at"])) : "—" %> e congelados nesta versão; a conversão em reserva usa estes valores.</p>
  </section>
  <section class="panel" aria-labelledby="acoes-titulo">
    <h2 id="acoes-titulo">Situação e ações</h2>
    <dl class="details">
      <dt>Situação</dt><dd><%= q.status_label %></dd>
      <% if q.sent_at %><dt>Enviado em</dt><dd><%= datetime(q.sent_at) %></dd><% end %>
      <% if q.approved_at %>
        <dt>Versão aprovada</dt><dd><%= q.approved_version %></dd>
        <dt>Aprovado por</dt><dd><%= q.approved_by_name %> (<%= q.approver_label %>)</dd>
        <dt>Instante e IP</dt><dd><%= datetime(q.approved_at) %> · <%= q.approved_ip || "IP não informado" %></dd>
      <% end %>
      <% if q.rejected_at %><dt>Rejeitado em</dt><dd><%= datetime(q.rejected_at) %> · <%= q.rejection_reason %></dd><% end %>
      <% if q.expired_at %><dt>Expirado em</dt><dd><%= datetime(q.expired_at) %></dd><% end %>
      <% if @data[:reservation] %><dt>Reserva</dt><dd><a href="/reservas/<%= @data[:reservation].id %>"><%= @data[:reservation].code %></a> (<%= @data[:reservation].status_label %>)</dd><% end %>
    </dl>
    <% if can?("quotes.write") %>
      <div class="action-row">
        <% if q.status == "draft" %>
          <form method="post" action="/orcamentos/<%= q.id %>/enviar"><%= csrf_field %><button type="submit" class="primary">Enviar versão <%= q.current_version %> ao cliente</button></form>
        <% end %>
        <% if q.revisable? %><a class="button" href="/orcamentos/<%= q.id %>/nova-versao">Nova versão</a><% end %>
        <% if q.status == "approved" && can?("reservations.write") %>
          <form method="post" action="/orcamentos/<%= q.id %>/converter"><%= csrf_field %><button type="submit" class="primary">Converter em reserva</button></form>
        <% end %>
      </div>
      <% if q.status == "approved" && !q.hold_on_send? %><p class="muted">A conversão verifica a disponibilidade agora: o orçamento enviado sem bloqueio não a garantia.</p><% end %>
      <% if q.status == "sent" %>
        <details>
          <summary>Registrar aprovação do cliente</summary>
          <form method="post" action="/orcamentos/<%= q.id %>/aprovar" class="stack">
            <%= csrf_field %>
            <input type="hidden" name="versao" value="<%= q.current_version %>">
            <p>A aprovação vale para a <strong>versão <%= q.current_version %></strong> (total <%= money(current.total) %>), dentro da validade.</p>
            <label for="aprovado_por">Nome de quem aprovou pelo cliente</label>
            <input id="aprovado_por" name="aprovado_por" required maxlength="160"<%= invalid(@errors, "aprovado_por") %>>
            <%= field_errors(@errors, "aprovado_por") %>
            <p class="muted">Serão registrados o seu usuário, o IP desta requisição e o instante da aprovação.</p>
            <button type="submit" class="primary">Registrar aprovação</button>
          </form>
        </details>
        <details>
          <summary>Registrar rejeição</summary>
          <form method="post" action="/orcamentos/<%= q.id %>/rejeitar" class="stack">
            <%= csrf_field %>
            <label for="motivo-rejeicao">Motivo</label>
            <input id="motivo-rejeicao" name="motivo" required maxlength="500"<%= invalid(@errors, "motivo") %>>
            <%= field_errors(@errors, "motivo") %>
            <button type="submit" class="danger">Registrar rejeição</button>
          </form>
        </details>
      <% end %>
    <% end %>
  </section>
</div>
<section class="panel" aria-labelledby="versoes-titulo">
  <h2 id="versoes-titulo">Versões</h2>
  <table class="table">
    <thead><tr><th scope="col">Versão</th><th scope="col">Criada em</th><th scope="col">Período</th><th scope="col">Validade</th><th scope="col" class="num">Total</th></tr></thead>
    <tbody>
      <% @data[:versions].each do |version| %>
        <tr>
          <td><a href="/orcamentos/<%= q.id %>?versao=<%= version.number %>"<%= version.number == v.number ? raw(' aria-current="true"') : raw("") %>>Versão <%= version.number %></a>
            <% if version.number == q.current_version %><%= badge("atual", "info") %><% end %><% if version.number == q.approved_version %><%= badge("aprovada", "success") %><% end %></td>
          <td><%= datetime(version.created_at) %></td>
          <td><%= datetime(version.period.starts_at) %> a <%= datetime(version.period.ends_at) %></td>
          <td><%= datetime(version.valid_until) %></td>
          <td class="num"><%= money(version.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="muted">Versões são imutáveis: alterações criam uma nova versão.</p>
</section>
<%= partial("shared/attachments", attachments: @attachments, owner_type: "quote", owner_id: q.id, can_upload: can?("quotes.write")) %>
<section class="panel" aria-labelledby="historico-titulo">
  <h2 id="historico-titulo">Histórico</h2>
  <% if @history.empty? %><p class="empty">Sem eventos.</p><% else %>
    <ol class="timeline">
      <% @history.each do |event| %>
        <li><time><%= datetime(event["occurred_at"]) %></time> <strong><%= event["action"] %></strong> <span class="muted"><%= event["actor_name"] || event["actor_type"] %></span></li>
      <% end %>
    </ol>
  <% end %>
</section>
