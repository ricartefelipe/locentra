<%# Pré-visualização da política, da validade padrão do bloqueio e, na troca de fuso, do horário atual nos dois fusos. Locais: preview, data. %>
<% policy = Locentra::Domain::Organizations::CancellationPolicy -%>
<% comparison = @preview[:comparison] -%>
<section id="previa-politica" class="panel" aria-live="polite" aria-labelledby="previa-titulo">
  <h2 id="previa-titulo">Pré-visualização</h2>
  <ul class="row-list">
    <% policy.describe(@preview[:policy]).each do |line| %><li><%= line %></li><% end %>
  </ul>
  <p class="muted small" aria-hidden="true">Exemplo sobre um contrato de <%= money(100_000) %></p>
  <table class="table">
    <caption class="sr-only">Exemplo sobre um contrato de <%= money(100_000) %></caption>
    <thead><tr><th scope="col">Antecedência</th><th scope="col" class="num">Multa</th><th scope="col" class="num">Valor</th></tr></thead>
    <tbody>
      <% policy.examples(@preview[:policy]).each do |example| -%>
        <tr><td><%= example["range"] %></td><td class="num"><%= percent(example["fee_bps"]) %></td><td class="num"><%= money(example["fee"]) %></td></tr>
      <% end -%>
    </tbody>
  </table>
  <% if comparison -%>
    <p class="notice">Agora: <%= comparison[:from].format_local(@data[:now]) %> em <%= comparison[:from].identifier %> → <%= comparison[:to].format_local(@data[:now]) %> em <%= comparison[:to].identifier %></p>
    <% unless comparison[:confirmed] %><p class="notice notice-danger"><strong>Para salvar, marque a confirmação da troca do fuso horário.</strong></p><% end -%>
  <% end -%>
  <p class="muted small">Bloqueios criados sem validade informada vencem em <%= @preview[:hold_minutes] %> minutos.</p>
</section>
