<% if @rows.empty? %>
  <p class="empty">Nenhuma reserva encontrada.</p>
<% else %>
  <div class="table-scroll">
    <table class="table">
      <thead><tr><th scope="col">Código</th><th scope="col">Cliente</th><th scope="col">Retirada</th><th scope="col">Devolução</th><th scope="col">Situação</th><th scope="col" class="num">Total</th></tr></thead>
      <tbody>
        <% @rows.each do |row| %>
          <% r = row[:reservation] %>
          <tr>
            <td><a href="/reservas/<%= r.id %>"><%= r.code %></a></td>
            <td><%= row[:customer_name] %></td>
            <td><%= datetime(r.period.starts_at) %></td>
            <td><%= datetime(r.period.ends_at) %></td>
            <td><%= status_badge(r.status, r.status_label) %></td>
            <td class="num"><%= money(r.total) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
