<header class="page-header"><h1>Nova reserva</h1></header>
<section class="panel">
  <%= partial("shared/errors") %>
  <%= partial("shared/shortages") %>
  <form method="post" action="/reservas" class="form-grid" data-line-items>
    <%= csrf_field %>
    <div><label for="cliente_id">Cliente</label>
      <select id="cliente_id" name="cliente_id" required>
        <option value="">Selecione</option>
        <% @customers.each do |c| %><option value="<%= c.id %>"<%= selected(@values["cliente_id"], c.id) %>><%= c.name %> (<%= c.formatted_document %>)</option><% end %>
      </select>
      <% if @customers.empty? %><p class="muted"><a href="/clientes/novo">Cadastre um cliente</a> antes de reservar.</p><% end %>
    </div>
    <div><label for="filial_id">Filial</label>
      <select id="filial_id" name="filial_id" required>
        <% @branches.each do |b| %><option value="<%= b.id %>"<%= selected(@values["filial_id"], b.id) %>><%= b.name %> (<%= b.code %>)</option><% end %>
      </select></div>
    <div><label for="inicio">Retirada (horário local <%= time_zone.identifier %>)</label>
      <input id="inicio" name="inicio" type="datetime-local" required value="<%= @values["inicio"] %>"<%= invalid(@errors, "inicio") %>><%= field_errors(@errors, "inicio") %></div>
    <div><label for="fim">Devolução</label>
      <input id="fim" name="fim" type="datetime-local" required value="<%= @values["fim"] %>"<%= invalid(@errors, "fim") %>><%= field_errors(@errors, "fim") %></div>
    <fieldset class="full">
      <legend>Itens</legend>
      <div data-lines>
        <% rows = [Array(@values["produto"]).size, 1].max %>
        <% rows.times do |i| %>
          <div class="line" data-line>
            <label for="produto-<%= i %>">Produto ou kit</label>
            <select id="produto-<%= i %>" name="produto[]">
              <option value="">Selecione</option>
              <% @products.each do |p| %><option value="<%= p.id %>"<%= selected(Array(@values["produto"])[i], p.id) %>><%= p.name %> · <%= p.tracking_label %></option><% end %>
            </select>
            <label for="quantidade-<%= i %>">Quantidade</label>
            <input id="quantidade-<%= i %>" name="quantidade[]" type="number" min="1" value="<%= Array(@values["quantidade"])[i] || 1 %>">
            <button type="button" class="link-button" data-remove-line>Remover</button>
          </div>
        <% end %>
      </div>
      <button type="button" data-add-line>Adicionar item</button>
    </fieldset>
    <fieldset class="full">
      <legend>Política de bloqueio</legend>
      <label class="radio"><input type="radio" name="modo" value="hold"<%= checked(@values["modo"].to_s.empty? || @values["modo"] == "hold") %>>
        Bloqueio temporário: reserva a disponibilidade agora e expira se não for confirmada.</label>
      <label class="radio"><input type="radio" name="modo" value="confirm"<%= checked(@values["modo"] == "confirm") %>>
        Confirmar agora: aloca e confirma na mesma operação.</label>
      <label class="radio"><input type="radio" name="modo" value="request"<%= checked(@values["modo"] == "request") %>>
        Solicitação: registra o pedido sem garantir disponibilidade; a alocação ocorre na confirmação.</label>
      <label for="validade_bloqueio">Validade do bloqueio temporário (minutos)</label>
      <input id="validade_bloqueio" name="validade_bloqueio" type="number" min="5" max="1440" value="<%= @values["validade_bloqueio"] || @hold_minutes %>">
    </fieldset>
    <div><label for="cupom">Cupom</label><input id="cupom" name="cupom" value="<%= @values["cupom"] %>"<%= invalid(@errors, "cupom") %>><%= field_errors(@errors, "cupom") %></div>
    <div><label for="desconto">Desconto manual (%)</label><input id="desconto" name="desconto" inputmode="decimal" value="<%= @values["desconto"] %>">
      <p class="muted">Limite do seu papel: <%= percent(Locentra::Domain::Identity.discount_limit_bps(request.actor.role)) %></p></div>
    <div class="full"><label for="observacoes">Observações</label><textarea id="observacoes" name="observacoes" rows="2"><%= @values["observacoes"] %></textarea></div>
    <div class="full actions"><button type="submit" class="primary">Registrar reserva</button> <a href="/reservas">Cancelar</a></div>
  </form>
</section>
