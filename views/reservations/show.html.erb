<% r = @data[:reservation] %>
<% pricing = @data[:pricing][:summary] %>
<% contract = @links[:contract] %>
<% contract_open = contract&.open? %>
<% quote_hold = @links[:quote]&.holds_reservation?(r.id) %>
<% can_confirm = can?("reservations.write") && %w[requested held].include?(r.status) && !quote_hold %>
<% can_reschedule = can?("reservations.write") && %w[requested held confirmed].include?(r.status) && !quote_hold && !contract_open %>
<% can_extend = can?("reservations.write") && %w[held confirmed in_progress].include?(r.status) && !contract_open && !quote_hold %>
<% can_cancel = can?("reservations.cancel") && %w[requested held confirmed].include?(r.status) && !contract_open %>
<% next_step = { "confirmed" => "Próxima etapa: retirada em #{datetime(r.period.starts_at)}.", "in_progress" => "Próxima etapa: devolução até #{datetime(r.period.ends_at)}." }[r.status] %>
<% allocations = @data[:allocations] %>
<header class="page-header">
  <h1>Reserva <%= r.code %> <%= status_badge(r.status, r.status_label) %></h1>
  <p class="page-meta"><span>Cliente <a href="/clientes/<%= @customer.id %>"><%= @customer.name %></a></span></p>
</header>
<%= partial("shared/errors") %>
<%= partial("shared/shortages") %>
<% if r.held? %>
  <div class="notice<%= r.hold_valid?(@now) ? "" : " notice-danger" %>" role="status">
    <% if r.hold_valid?(@now) %>
      Bloqueio temporário válido até <strong><%= datetime(r.hold_expires_at) %></strong>. A confirmação revalida a disponibilidade.
    <% else %>
      O bloqueio temporário expirou em <%= datetime(r.hold_expires_at) %>; a disponibilidade foi liberada.
    <% end %>
  </div>
<% elsif r.requested? %>
  <div class="notice" role="status">Solicitação sem garantia de disponibilidade. A alocação ocorre somente na confirmação.</div>
<% end %>
<% if quote_hold %>
  <div class="notice" role="status">Esta reserva é o bloqueio temporário do orçamento <a href="/orcamentos/<%= @links[:quote].id %>"><%= @links[:quote].code %></a>: a confirmação é feita pela conversão do orçamento aprovado e alterações de período ou itens exigem uma nova versão do orçamento. O cancelamento libera a disponibilidade, como o vencimento do bloqueio.</div>
<% end %>
<% if contract_open %>
  <div class="notice" role="status">Esta reserva possui o contrato <a href="/contratos/<%= contract.id %>"><%= contract.code %></a>: alterações de prazo são feitas por aditivo e o cancelamento pelo contrato, que aplica a política de cancelamento.</div>
<% end %>
<div class="detail-layout">
  <div class="detail-main">
    <section class="panel" aria-labelledby="contrato-titulo">
      <h2 id="contrato-titulo">Contrato e orçamento</h2>
      <% if @links[:quote] || contract %>
        <ul class="row-list">
          <% if @links[:quote] %>
            <% quote = @links[:quote] %>
            <li><%= quote.reservation_id == r.id ? "Convertida do orçamento" : "Bloqueio temporário do orçamento" %> <a href="/orcamentos/<%= quote.id %>"><%= quote.code %></a> <%= status_badge(quote.status, quote.status_label) %></li>
          <% end %>
          <% if contract %>
            <li>Contrato <a href="/contratos/<%= contract.id %>"><%= contract.code %></a> <%= status_badge(contract.status, contract.status_label) %><span class="cell-sub">Documento na versão <%= contract.current_document_version %></span></li>
          <% end %>
        </ul>
      <% end %>
      <% if !contract && can?("contracts.write") && Locentra::Domain::Contracts::ISSUABLE_RESERVATION_STATUSES.include?(r.status) %>
        <form method="post" action="/contratos" class="stack">
          <%= csrf_field %>
          <input type="hidden" name="reserva_id" value="<%= r.id %>">
          <label for="contrato-condicoes">Condições específicas (opcional)</label>
          <textarea id="contrato-condicoes" name="condicoes" rows="2" maxlength="5000"></textarea>
          <p class="muted small">O contrato congela itens, preços, caução, período e a política de cancelamento registrada na reserva e gera o PDF para aceite eletrônico simples.</p>
          <button type="submit" class="primary">Gerar contrato</button>
        </form>
      <% elsif !contract && can?("contracts.read") %>
        <p class="empty">Sem contrato. O contrato pode ser gerado depois que a reserva for confirmada.</p>
      <% end %>
    </section>
    <section class="panel" aria-labelledby="itens-titulo">
      <header class="panel-header"><h2 id="itens-titulo">Itens e alocações <span class="count"><%= @data[:items].size %></span></h2></header>
      <div class="table-scroll">
        <table class="table">
          <thead><tr><th scope="col">Item</th><th scope="col" class="num">Qtd.</th><th scope="col">Cobrança</th><th scope="col">Condição</th><th scope="col" class="num">Total</th><th scope="col">Alocação</th></tr></thead>
          <tbody>
            <% @data[:items].each do |item| %>
              <tr>
                <td><%= item["name"] %><span class="cell-sub mono"><%= item["sku"] %></span></td>
                <td class="num"><%= item["quantity"] %></td>
                <td><%= item["pricing"]["description"] %></td>
                <td><%= negotiated_discount(item) %></td>
                <td class="num"><%= money(item["total_cents"]) %></td>
                <td>
                  <% assets = allocations[:assets].select { |a| a["reservation_item_id"] == item["id"] && a["active"] } %>
                  <% stock = allocations[:stock].select { |s| s["reservation_item_id"] == item["id"] && s["active"] } %>
                  <% if assets.empty? && stock.empty? %><span class="muted">sem alocação ativa</span><% end %>
                  <% assets.each do |a| %><a class="mono" href="/ativos/<%= a["asset_id"] %>"><%= a["tag"] %></a> <% end %>
                  <% stock.each do |s| %><%= s["quantity"] %> un. <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
    <% if @finance %><%= partial("finance/reservation_panel", reservation: r) %><% end %>
    <%= partial("operations/reservation_summary", reservation: r, operations: @operations) %>
    <section class="panel" aria-labelledby="historico-titulo">
      <h2 id="historico-titulo">Histórico</h2>
      <% if @history.empty? %><p class="empty">Sem eventos.</p><% else %>
        <ol class="timeline">
          <% @history.each do |event| %>
            <li><time><%= datetime(event["occurred_at"]) %></time> <strong><%= label(:audit_action, event["action"]) %></strong> <span class="muted"><%= event["actor_name"] || label(:actor_type, event["actor_type"]) %></span></li>
          <% end %>
        </ol>
      <% end %>
    </section>
  </div>
  <aside class="detail-aside" aria-label="Resumo da reserva">
    <section class="panel" aria-labelledby="periodo-titulo">
      <h2 id="periodo-titulo">Período</h2>
      <dl class="details">
        <dt>Retirada</dt><dd><%= datetime(r.period.starts_at) %></dd>
        <dt>Devolução</dt><dd><%= datetime(r.period.ends_at) %></dd>
        <dt>Origem</dt><dd><%= label(:reservation_source, r.source) %></dd>
      </dl>
      <% if r.notes %>
        <span class="eyebrow">Observações</span>
        <p class="pre"><%= r.notes %></p>
      <% end %>
      <p class="amount"><span class="amount-label">Total contratado</span><strong><%= money(r.total) %></strong></p>
    </section>
    <% if can_confirm || can_reschedule || can_extend || can_cancel || next_step %>
      <section class="panel" aria-labelledby="acoes-titulo">
        <h2 id="acoes-titulo">Próxima ação</h2>
        <% if next_step %><p class="muted"><%= next_step %> <a href="#h-operacao">Ver retirada e devolução</a></p><% end %>
        <% if can_confirm %>
          <form method="post" action="/reservas/<%= r.id %>/confirmar"><%= csrf_field %><button type="submit" class="primary">Confirmar reserva</button></form>
        <% end %>
        <% if can_reschedule %>
          <details<%= open_after_failure("/reservas/#{r.id}/reagendar") %>>
            <summary>Reagendar</summary>
            <form method="post" action="/reservas/<%= r.id %>/reagendar" class="stack">
              <%= csrf_field %><%= time_zone_field %>
              <label for="re-inicio">Nova retirada</label><input id="re-inicio" name="inicio" type="datetime-local" required value="<%= local_input(r.period.starts_at) %>">
              <label for="re-fim">Nova devolução</label><input id="re-fim" name="fim" type="datetime-local" required value="<%= local_input(r.period.ends_at) %>">
              <button type="submit">Reagendar</button>
            </form>
          </details>
        <% end %>
        <% if can_extend %>
          <details<%= open_after_failure("/reservas/#{r.id}/estender") %>>
            <summary>Estender devolução</summary>
            <form method="post" action="/reservas/<%= r.id %>/estender" class="stack">
              <%= csrf_field %><%= time_zone_field %>
              <label for="ex-fim">Nova devolução</label><input id="ex-fim" name="fim" type="datetime-local" required value="<%= local_input(r.period.ends_at) %>">
              <p class="muted small">A cobrança original é mantida; a diferença é registrada como ajuste.</p>
              <button type="submit">Estender</button>
            </form>
          </details>
        <% end %>
        <% if can_cancel %>
          <details<%= open_after_failure("/reservas/#{r.id}/cancelar") %>>
            <summary>Cancelar reserva</summary>
            <form method="post" action="/reservas/<%= r.id %>/cancelar" class="stack" data-confirm="Cancelar esta reserva e liberar a disponibilidade?">
              <%= csrf_field %>
              <label for="motivo">Motivo</label><input id="motivo" name="motivo" required maxlength="500">
              <button type="submit" class="danger">Cancelar reserva</button>
            </form>
          </details>
        <% end %>
      </section>
    <% end %>
    <section class="panel" aria-labelledby="valores-titulo">
      <h2 id="valores-titulo">Valores</h2>
      <dl class="details">
        <%= partial("shared/pricing_summary", pricing: pricing, items: @data[:items], audience: :staff, total: r.total, total_label: "Total contratado") %>
        <dt>Caução prevista</dt><dd><%= money(r.deposit) %></dd>
        <% @data[:pricing][:adjustments].each do |adj| %>
          <dt>Ajuste (<%= label(:adjustment_kind, adj["kind"]) %>)</dt><dd><%= money(adj["amount_cents"]) %><span class="cell-sub">em <%= datetime(adj["created_at"]) %></span></dd>
        <% end %>
      </dl>
      <p class="muted small">Preços congelados em <%= pricing["priced_at"] ? datetime(Time.iso8601(pricing["priced_at"])) : "—" %>; alterações de catálogo não afetam esta reserva.</p>
      <%= partial("shared/cancellation_policy", policy: @data[:cancellation_policy], title: "Política de cancelamento desta reserva") %>
    </section>
  </aside>
</div>
