<section class="panel narrow" aria-labelledby="titulo-entrar">
  <h1 id="titulo-entrar">Entrar</h1>
  <% if @error %>
    <div class="form-errors" role="alert" tabindex="-1" data-autofocus><p><%= @error %></p></div>
  <% end %>
  <form method="post" action="/entrar" class="stack">
    <input type="hidden" name="voltar" value="<%= @back %>">
    <label for="email">E-mail</label>
    <input id="email" name="email" type="email" autocomplete="username" required value="<%= @values["email"] %>" autofocus>
    <label for="senha">Senha</label>
    <input id="senha" name="senha" type="password" autocomplete="current-password" required>
    <button type="submit" class="primary">Entrar</button>
  </form>
  <p class="links"><a href="/recuperar-senha">Esqueci minha senha</a> · <a href="/cadastro">Criar conta para minha empresa</a></p>
</section>
