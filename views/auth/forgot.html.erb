<section class="panel narrow" aria-labelledby="titulo-recuperar">
  <h1 id="titulo-recuperar">Recuperar senha</h1>
  <% if @sent %>
    <p class="notice" role="status">Se houver uma conta com este e-mail, enviaremos um link válido por 1 hora e de uso único.</p>
  <% else %>
    <p class="muted">Informe o e-mail da conta. Enviaremos um link para você definir uma nova senha.</p>
    <form method="post" action="/recuperar-senha" class="stack">
      <label for="email">E-mail da conta</label>
      <input id="email" name="email" type="email" autocomplete="email" required autofocus>
      <button type="submit" class="primary">Enviar link</button>
    </form>
  <% end %>
  <p class="links"><a href="/entrar">Voltar para entrar</a></p>
</section>
