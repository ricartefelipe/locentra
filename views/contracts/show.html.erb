<% c = @data[:contract] %>
<% terms = c.terms %>
<% r = @data[:reservation] %>
<% current_doc = @data[:documents].find { |d| d["version"] == c.current_document_version } %>
<header class="page-header">
  <h1>Contrato <%= c.code %> <%= status_badge(c.status, c.status_label) %></h1>
  <% if current_doc %>
    <div class="actions"><a class="button" href="/anexos/<%= current_doc["attachment_id"] %>">Baixar PDF vigente</a></div>
  <% end %>
  <p class="page-meta"><span>Locatário <a href="/clientes/<%= c.customer_id %>"><%= terms.dig("customer", "name") %></a></span><span>Reserva <a href="/reservas/<%= r.id %>"><%= r.code %></a> <%= status_badge(r.status, r.status_label) %></span><% if terms["quote"] %><span>Orçamento <a href="/orcamentos/<%= terms.dig("quote", "id") %>"><%= terms.dig("quote", "code") %></a>, versão <%= terms.dig("quote", "version") %></span><% end %></p>
</header>
<%= partial("shared/errors") %>
<%= partial("shared/shortages") %>
<div class="detail-layout">
  <div class="detail-main">
    <section class="panel" aria-labelledby="termos-titulo">
      <h2 id="termos-titulo">Termos contratados</h2>
      <table class="table">
        <caption class="sr-only">Itens contratados</caption>
        <thead><tr><th scope="col">Item</th><th scope="col" class="num">Qtd.</th><th scope="col">Cobrança</th><th scope="col" class="num">Total</th></tr></thead>
        <tbody>
          <% terms["items"].each do |item| %>
            <tr><td><%= item["name"] %><span class="cell-sub mono"><%= item["sku"] %></span></td><td class="num"><%= item["quantity"] %></td>
              <td><%= item["description"] %><% if item["negotiated_discount_cents"].to_i.positive? %><span class="cell-sub">condição negociada <%= negotiated_discount(item) %></span><% end %></td>
              <td class="num"><%= money(item["total_cents"]) %></td></tr>
          <% end %>
        </tbody>
      </table>
      <h3>Valores na emissão</h3>
      <dl class="details">
        <%= partial("shared/pricing_summary", pricing: terms["pricing"] || {}, items: terms["items"], audience: :staff, total: terms["total_cents"].to_i) %>
      </dl>
      <h3>Política de cancelamento</h3>
      <ul>
        <% terms["cancellation_terms"].each do |text| %><li><%= text %></li><% end %>
      </ul>
      <% if terms["conditions"] %><h3>Condições específicas</h3><p class="pre"><%= terms["conditions"] %></p><% end %>
    </section>
    <section class="panel" aria-labelledby="documentos-titulo">
      <h2 id="documentos-titulo">Documentos e aceite <span class="count"><%= @data[:documents].size %></span></h2>
      <p class="muted small"><%= Locentra::Domain::Contracts::ACCEPTANCE_NOTICE %></p>
      <div class="table-scroll">
        <table class="table">
          <thead><tr><th scope="col">Documento</th><th scope="col">Motivo</th><th scope="col">Gerado em</th><th scope="col">Aceite</th></tr></thead>
          <tbody>
            <% @data[:documents].each do |doc| %>
              <tr>
                <td><a href="/anexos/<%= doc["attachment_id"] %>">PDF versão <%= doc["version"] %></a><span class="cell-sub mono" title="SHA-256 <%= doc["sha256"] %>">SHA-256 <%= doc["sha256"][0, 16] %>…</span></td>
                <td><%= Locentra::Domain::Contracts::DOCUMENT_REASONS.fetch(doc["reason"]) %></td>
                <td><%= datetime(doc["generated_at"]) %><span class="cell-sub">retido até <%= date(doc["retain_until"]) %></span></td>
                <td>
                  <% if doc["accepted_at"] %>
                    <%= badge("Aceite eletrônico simples", "success") %>
                    <span class="cell-sub"><%= doc["accepted_by_name"] %> · <%= Locentra::Domain::Customers::Document.format(doc["accepted_by_document"]) %></span>
                    <span class="cell-sub"><%= datetime(doc["accepted_at"]) %> · IP <%= doc["accepted_ip"] || "não informado" %> · <%= Locentra::Domain::Contracts::ACCEPTANCE_CHANNELS.fetch(doc["accepted_via"]) %></span>
                  <% else %>
                    <%= badge("Sem aceite registrado", c.open? && doc["version"] == c.current_document_version ? "warning" : "muted") %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
    <section class="panel" aria-labelledby="aditivos-titulo">
      <h2 id="aditivos-titulo">Aditivos <span class="count"><%= @data[:amendments].size %></span></h2>
      <% if @data[:amendments].empty? %>
        <p class="empty">Nenhum aditivo registrado.</p>
      <% else %>
        <div class="table-scroll">
          <table class="table">
            <thead><tr><th scope="col">Nº</th><th scope="col">Aditivo</th><th scope="col">Documento</th><th scope="col">Registrado em</th><th scope="col" class="num">Diferença</th></tr></thead>
            <tbody>
              <% @data[:amendments].each do |a| %>
                <tr><td><%= a["number"] %></td><td><%= Locentra::Domain::Contracts::AMENDMENT_KINDS.fetch(a["kind"]) %><% if a["description"] %><span class="cell-sub"><%= a["description"] %></span><% end %></td>
                  <td>versão <%= a["document_version"] %></td><td><%= datetime(a["created_at"]) %></td><td class="num"><%= money(a["amount_delta_cents"]) %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <% if c.amendable? && can?("contracts.write") && can?("reservations.write") %>
        <details<%= open_if(@errors, "fim") %>>
          <summary>Aditivo de extensão de prazo</summary>
          <form method="post" action="/contratos/<%= c.id %>/aditivos" class="stack">
            <%= csrf_field %><%= time_zone_field %>
            <label for="aditivo-fim">Nova devolução (horário local <%= time_zone.identifier %>)</label>
            <input id="aditivo-fim" name="fim" type="datetime-local" required value="<%= local_input(r.period.ends_at) %>"<%= invalid(@errors, "fim") %>>
            <%= field_errors(@errors, "fim") %>
            <label for="aditivo-descricao">Descrição (opcional)</label>
            <input id="aditivo-descricao" name="descricao" maxlength="1000">
            <p class="muted small">A diferença é calculada com a tabela de preços contratada e registrada como ajuste da reserva. Um novo documento é gerado. Se o novo prazo invadir outra reserva, nada é alterado.</p>
            <button type="submit">Registrar aditivo</button>
          </form>
        </details>
      <% end %>
    </section>
    <section class="panel" aria-labelledby="historico-contrato">
      <h2 id="historico-contrato">Histórico</h2>
      <% if @history.empty? %><p class="empty">Sem eventos.</p><% else %>
        <ol class="timeline">
          <% @history.each do |event| %>
            <li><time><%= datetime(event["occurred_at"]) %></time> <strong><%= label(:audit_action, event["action"]) %></strong> <span class="muted"><%= event["actor_name"] || label(:actor_type, event["actor_type"]) %></span></li>
          <% end %>
        </ol>
      <% end %>
    </section>
  </div>
  <aside class="detail-aside">
    <section class="panel" aria-labelledby="resumo-titulo">
      <h2 id="resumo-titulo">Resumo</h2>
      <dl class="details">
        <dt>Emitido em</dt><dd><%= datetime(c.issued_at) %></dd>
        <dt>Retirada</dt><dd><%= datetime(r.period.starts_at) %></dd>
        <dt>Devolução vigente</dt><dd><%= datetime(r.period.ends_at) %></dd>
        <dt>Valor na emissão</dt><dd><%= money(c.contracted_total) %></dd>
        <% unless @data[:amendments].empty? %><dt>Diferenças de aditivos</dt><dd><%= money(@data[:current_total] - c.contracted_total) %></dd><% end %>
        <dt>Caução prevista</dt><dd><%= money(terms["deposit_cents"]) %></dd>
        <% if c.cancelled_at %>
          <dt>Cancelado em</dt><dd><%= datetime(c.cancelled_at) %></dd>
          <dt>Motivo</dt><dd><%= c.cancellation_reason %></dd>
          <dt>Multa aplicada</dt><dd><%= money(c.cancellation_fee_cents.to_i) %></dd>
        <% end %>
        <% if c.closed_at %><dt>Encerrado em</dt><dd><%= datetime(c.closed_at) %></dd><% end %>
      </dl>
      <p class="amount"><span class="amount-label">Total contratado vigente</span><strong><%= money(@data[:current_total]) %></strong></p>
    </section>
    <% if c.open? && can?("contracts.write") && current_doc && current_doc["accepted_at"].nil? %>
      <section class="panel" aria-labelledby="aceite-titulo">
        <h2 id="aceite-titulo">Aceite</h2>
        <p class="muted small">O documento vigente (versão <%= c.current_document_version %>) ainda não tem aceite registrado.</p>
        <details<%= open_if(@errors, "nome", "documento", "declaracao") %>>
          <summary>Registrar aceite da versão <%= c.current_document_version %></summary>
          <form method="post" action="/contratos/<%= c.id %>/aceite" class="stack">
            <%= csrf_field %>
            <input type="hidden" name="versao" value="<%= c.current_document_version %>">
            <p>Registro presencial do aceite eletrônico simples do locatário. Não equivale a assinatura digital certificada.</p>
            <label for="aceite-nome">Nome completo de quem aceita</label>
            <input id="aceite-nome" name="nome" required maxlength="160" value="<%= terms.dig("customer", "name") %>"<%= invalid(@errors, "nome") %>>
            <%= field_errors(@errors, "nome") %>
            <label for="aceite-documento">CPF ou CNPJ de quem aceita</label>
            <input id="aceite-documento" name="documento" required inputmode="numeric"<%= invalid(@errors, "documento") %>>
            <%= field_errors(@errors, "documento") %>
            <label class="checkbox"><input type="checkbox" name="declaracao" value="1" required<%= invalid(@errors, "declaracao") %>> <%= Locentra::Domain::Contracts::ACCEPTANCE_STATEMENT %></label>
            <%= field_errors(@errors, "declaracao") %>
            <p class="muted small">Serão registrados o IP e o navegador desta requisição e o instante do aceite.</p>
            <button type="submit" class="primary">Registrar aceite</button>
          </form>
        </details>
      </section>
    <% end %>
    <% if c.open? && r.status == "completed" && can?("contracts.write") %>
      <section class="panel" aria-labelledby="encerramento-titulo">
        <h2 id="encerramento-titulo">Encerramento</h2>
        <% if c.status == "issued" %><p class="notice" role="status">Nenhum aceite eletrônico simples foi registrado para este contrato; o encerramento fica registrado sem aceite.</p><% end %>
        <form method="post" action="/contratos/<%= c.id %>/encerrar"><%= csrf_field %><button type="submit" class="primary">Encerrar contrato</button></form>
      </section>
    <% end %>
    <% if c.open? && @data[:preview] %>
      <% preview = @data[:preview] %>
      <section class="panel" aria-labelledby="cancelamento-titulo">
        <h2 id="cancelamento-titulo">Cancelamento</h2>
        <p class="muted small">Prévia para cancelamento agora (<%= datetime(@now) %>).</p>
        <dl class="details">
          <dt>Antecedência</dt><dd><%= preview.hours_before %> h</dd>
          <dt>Multa</dt><dd><%= Locentra::Domain::Contracts::Cancellation.percent_label(preview.fee_bps) %></dd>
          <dt>Base de cálculo</dt><dd><%= money(preview.base) %></dd>
        </dl>
        <p class="amount"><span class="amount-label">Valor da multa</span><strong><%= money(preview.fee) %></strong></p>
        <% if can?("contracts.write") && can?("reservations.cancel") %>
          <details<%= open_if(@errors, "motivo") %>>
            <summary>Cancelar contrato</summary>
            <form method="post" action="/contratos/<%= c.id %>/cancelar" class="stack" data-confirm="Cancelar o contrato, aplicar a multa calculada e liberar a reserva?">
              <%= csrf_field %>
              <label for="cancelamento-motivo">Motivo</label>
              <input id="cancelamento-motivo" name="motivo" required maxlength="500"<%= invalid(@errors, "motivo") %>>
              <%= field_errors(@errors, "motivo") %>
              <p class="muted small">A multa é recalculada no instante da confirmação e registrada como ajuste da reserva quando maior que zero.</p>
              <button type="submit" class="danger">Cancelar contrato</button>
            </form>
          </details>
        <% else %>
          <p class="muted small">O cancelamento exige as permissões de contratos e de cancelamento de reservas.</p>
        <% end %>
      </section>
    <% elsif c.open? %>
      <section class="panel" aria-labelledby="cancelamento-titulo">
        <h2 id="cancelamento-titulo">Cancelamento</h2>
        <p class="empty">A reserva está <%= r.status_label.downcase %>: depois da retirada o contrato não pode mais ser cancelado e é encerrado após a devolução.</p>
      </section>
    <% end %>
  </aside>
</div>
