<% c = @data[:customer] %>
<% contacts_path = "/clientes/#{c.id}/contatos" %>
<% addresses_path = "/clientes/#{c.id}/enderecos" %>
<header class="page-header">
  <div>
    <a class="eyebrow" href="/clientes">Clientes</a>
    <h1><%= c.name %> <%= status_badge(c.status, Locentra::Domain::Customers::STATUSES[c.status]) %></h1>
  </div>
  <% if c.status == "active" && (can?("reservations.write") || can?("quotes.write")) %>
    <div class="actions">
      <% if can?("quotes.write") %><a class="button" href="/orcamentos/novo?cliente_id=<%= c.id %>">Novo orçamento</a><% end %>
      <% if can?("reservations.write") %><a class="button primary" href="/reservas/nova?cliente_id=<%= c.id %>">Nova reserva</a><% end %>
    </div>
  <% end %>
  <p class="page-meta"><span><%= c.kind_label %></span><span><%= c.formatted_document %></span><% if c.trade_name %><span><%= c.trade_name %></span><% end %></p>
</header>
<%= partial("shared/errors") %>
<div class="detail-layout">
  <div class="detail-main">
    <section class="panel" aria-labelledby="reservas-recentes">
      <header class="panel-header"><h2 id="reservas-recentes">Reservas recentes <span class="count"><%= @reservations.total %></span></h2></header>
      <% if @reservations.items.empty? %>
        <p class="empty">Nenhuma reserva encontrada.</p>
      <% else %>
        <div class="table-scroll">
          <table class="table">
            <caption class="sr-only">Reservas recentes de <%= c.name %></caption>
            <thead><tr><th scope="col">Código</th><th scope="col">Retirada</th><th scope="col">Devolução</th><th scope="col">Situação</th><th scope="col" class="num">Total</th></tr></thead>
            <tbody>
              <% @reservations.items.each do |row| %>
                <% r = row[:reservation] %>
                <tr>
                  <td><a href="/reservas/<%= r.id %>"><%= r.code %></a></td>
                  <td><%= datetime(r.period.starts_at) %></td>
                  <td><%= datetime(r.period.ends_at) %></td>
                  <td><%= status_badge(r.status, r.status_label) %></td>
                  <td class="num"><%= money(r.total) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
    <section class="panel" aria-labelledby="contatos-titulo">
      <header class="panel-header"><h2 id="contatos-titulo">Contatos e pessoas autorizadas <span class="count"><%= @data[:contacts].size %></span></h2></header>
      <% if @data[:contacts].empty? %>
        <p class="empty">Nenhum contato cadastrado.</p>
      <% else %>
        <div class="table-scroll">
          <table class="table">
            <caption class="sr-only">Contatos de <%= c.name %></caption>
            <thead><tr><th scope="col">Nome</th><th scope="col">E-mail</th><th scope="col">Telefone</th><th scope="col">Retirada</th></tr></thead>
            <tbody>
              <% @data[:contacts].each do |contact| %>
                <tr>
                  <td><strong><%= contact.name %></strong><% if contact.role %><span class="cell-sub"><%= contact.role %></span><% end %></td>
                  <td><%= contact.email || "—" %></td>
                  <td><%= contact.phone || "—" %></td>
                  <td><% if contact.authorized_pickup %><%= badge("Autorizado a retirar", "info") %><% else %><span class="muted">—</span><% end %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <% if can?("customers.write") %>
        <details<%= open_after_failure(contacts_path) %>>
          <summary>Adicionar contato</summary>
          <form method="post" action="/clientes/<%= c.id %>/contatos" class="form-grid">
            <%= csrf_field %>
            <div><label for="ct-nome">Nome</label><input id="ct-nome" name="nome" value="<%= submitted(contacts_path, "nome") %>" required></div>
            <div><label for="ct-funcao">Função</label><input id="ct-funcao" name="funcao" value="<%= submitted(contacts_path, "funcao") %>"></div>
            <div><label for="ct-email">E-mail</label><input id="ct-email" name="email" value="<%= submitted(contacts_path, "email") %>" type="email"></div>
            <div><label for="ct-telefone">Telefone</label><input id="ct-telefone" name="telefone" value="<%= submitted(contacts_path, "telefone") %>"></div>
            <div><label for="ct-doc">CPF (obrigatório para retirada)</label><input id="ct-doc" name="documento" value="<%= submitted(contacts_path, "documento") %>" inputmode="numeric"></div>
            <div class="full"><label class="checkbox"><input type="checkbox" name="autorizado" value="1"> Autorizado a retirar equipamentos</label></div>
            <div class="full actions"><button type="submit">Adicionar</button></div>
          </form>
        </details>
      <% end %>
    </section>
    <section class="panel" aria-labelledby="enderecos-titulo">
      <header class="panel-header"><h2 id="enderecos-titulo">Endereços <span class="count"><%= @data[:addresses].size %></span></h2></header>
      <% if @data[:addresses].empty? %>
        <p class="empty">Nenhum endereço cadastrado.</p>
      <% else %>
        <ul class="row-list">
          <% @data[:addresses].each do |a| %>
            <li><span class="eyebrow"><%= a.label %></span><%= a.street %>, <%= a.number %> <%= a.complement %>
              <span class="cell-sub"><%= a.district %><%= a.district ? " — " : "" %><%= a.city %>/<%= a.state %><% if a.postal_code %> · CEP <%= a.postal_code %><% end %></span></li>
          <% end %>
        </ul>
      <% end %>
      <% if can?("customers.write") %>
        <details<%= open_after_failure(addresses_path) %>>
          <summary>Adicionar endereço</summary>
          <form method="post" action="/clientes/<%= c.id %>/enderecos" class="form-grid">
            <%= csrf_field %>
            <div><label for="en-rotulo">Rótulo</label><input id="en-rotulo" name="rotulo" value="principal" required></div>
            <div><label for="en-cep">CEP</label><input id="en-cep" name="cep" value="<%= submitted(addresses_path, "cep") %>" inputmode="numeric"></div>
            <div class="full"><label for="en-logradouro">Logradouro</label><input id="en-logradouro" name="logradouro" value="<%= submitted(addresses_path, "logradouro") %>" required></div>
            <div><label for="en-numero">Número</label><input id="en-numero" name="numero" value="<%= submitted(addresses_path, "numero") %>"></div>
            <div><label for="en-complemento">Complemento</label><input id="en-complemento" name="complemento" value="<%= submitted(addresses_path, "complemento") %>"></div>
            <div><label for="en-bairro">Bairro</label><input id="en-bairro" name="bairro" value="<%= submitted(addresses_path, "bairro") %>"></div>
            <div><label for="en-cidade">Cidade</label><input id="en-cidade" name="cidade" value="<%= submitted(addresses_path, "cidade") %>" required></div>
            <div><label for="en-uf">UF</label><input id="en-uf" name="uf" value="<%= submitted(addresses_path, "uf") %>" maxlength="2" required></div>
            <div class="full actions"><button type="submit">Adicionar</button></div>
          </form>
        </details>
      <% end %>
    </section>
    <% if @agreements %><%= partial("customers/price_agreements") %><% end %>
    <%= partial("customers/portal_access") %>
    <%= partial("shared/attachments", owner_type: "customer", owner_id: c.id, can_upload: can?("customers.write")) %>
  </div>
  <aside class="detail-aside" aria-labelledby="dados-cadastrais">
    <section class="panel">
      <h2 id="dados-cadastrais">Dados cadastrais</h2>
      <dl class="details">
        <dt>Tipo</dt><dd><%= c.kind_label %></dd>
        <dt>Documento</dt><dd><%= c.formatted_document %></dd>
        <% if c.trade_name %><dt>Nome fantasia</dt><dd><%= c.trade_name %></dd><% end %>
        <dt>E-mail</dt><dd><%= c.email || "—" %></dd>
        <dt>Telefone</dt><dd><%= c.phone || "—" %></dd>
      </dl>
      <h3>Observações</h3>
      <% if c.notes %><p class="pre"><%= c.notes %></p><% else %><p class="muted">Sem observações.</p><% end %>
      <% if can?("customers.write") %>
        <details<%= open_after_failure("/clientes/#{c.id}") %>>
          <summary>Editar cadastro</summary>
          <form method="post" action="/clientes/<%= c.id %>" class="stack">
            <%= csrf_field %>
            <label for="e-nome">Nome</label><input id="e-nome" name="nome" value="<%= c.name %>" required>
            <label for="e-fantasia">Nome fantasia</label><input id="e-fantasia" name="nome_fantasia" value="<%= c.trade_name %>">
            <label for="e-email">E-mail</label><input id="e-email" name="email" type="email" value="<%= c.email %>">
            <label for="e-telefone">Telefone</label><input id="e-telefone" name="telefone" value="<%= c.phone %>">
            <label for="e-situacao">Situação</label>
            <select id="e-situacao" name="situacao">
              <% Locentra::Domain::Customers::STATUSES.each do |key, label| %><option value="<%= key %>"<%= selected(c.status, key) %>><%= label %></option><% end %>
            </select>
            <label for="e-obs">Observações</label><textarea id="e-obs" name="observacoes" rows="3"><%= c.notes %></textarea>
            <button type="submit">Salvar</button>
          </form>
        </details>
      <% end %>
    </section>
  </aside>
</div>
